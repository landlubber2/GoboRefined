#!/bin/sh
# Photos for GoboRefined: pictures and videos in one simple window.  gobo-photos [FILE]
# 1.1: MIME defaults and Open-with come from Settings > Apps (gobo-settings-helper
# apps_mime_refresh); this program no longer writes ~/.config/mimeapps.list itself.
export NO_AT_BRIDGE=1
exec lua /Programs/Photos/Current/share/gobo-photos/photos.lua "$@"
