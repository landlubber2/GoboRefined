#!/bin/bash
# gobo-install — installer of GoboRefined, an unofficial spin of GoboLinux 017.01,
# for its live environment.
#
# Installs to one whole disk with the A/B layout of 0.8 (GPT): a boot partition with GRUB,
# two system slots (A gets the system, B stays empty until the first gobo-update) and a data
# partition for everything that survives updates. The system slot holds only the pristine
# image; this computer's settings go into the overlay on the data partition.
#
# Run as root from the live session:
#     gobo-install                 # asks questions
#     gobo-install --answers FILE  # unattended; FILE sets the variables below

set -euo pipefail

### Defaults (override with flags or an answers file) #########################

DISK=""                 # e.g. /dev/sda — the WHOLE disk is erased
HOSTNAME_NEW=""         # asked; default gobolinux
USER_NAME=""
USER_FULLNAME=""
ROOT_PASSWORD=""
USER_PASSWORD=""
TIMEZONE=""             # asked; default UTC; a path under /System/Index/share/zoneinfo
KEYMAP=""               # console keymap; default: same as the X layout if such a map exists, else us
XKB_LAYOUT=""           # X keyboard layout; asked; default: the live session's
AUTOLOGIN=0             # 1 = log USER_NAME in without a password
LOGIN_SCREEN=1          # 1 = graphical login screen (LXDM) if the image has it; 0 = text login on tty1
SWAP_MB=0               # size of a swap file on the data partition; 0 = none
CLOCK_MODE="GMT"        # hardware clock: GMT (UTC, the Linux norm) or LocalTime (dual boot with Windows)
LOOK_DIR=""             # folder with the gobo11 look; default: found automatically
SOURCE=""               # live image to install from; default: the live session's squashfs
ASSUME_YES=0

MIN_DISK_BYTES=32000000000   # "32 GB"
SLOT_MIB=12288               # each system slot: 12 GiB
DEST=/Mount/GoboLinux
LOG=/tmp/gobo-install.log
SPIN_NAME="GoboRefined"  # the spin's name (unofficial; based on GoboLinux 017.01)
SPIN_VERSION=""          # read from the GoboSpin program's share/spin-version below

### Helpers ####################################################################

c_cyan=$'\033[1;36m'; c_red=$'\033[1;31m'; c_off=$'\033[0m'
step() { echo "${c_cyan}==> $*${c_off}"; echo "==> $*" >> "$LOG"; }
die()  { echo "${c_red}gobo-install: $*${c_off}" >&2; exit 1; }
run()  { echo "+ $*" >> "$LOG"; "$@" >> "$LOG" 2>&1; }
in_target() { run chroot "$DEST" "$@"; }

work=""
cleanup() {
   local rc=$?
   trap - EXIT
   set +e
   for m in "$DEST" "${work:+$work/boot}" "${work:+$work/data}" "${work:+$work/slot}"
   do
      [ -n "$m" ] || continue
      mountpoint -q "$m" 2>/dev/null && { umount -R "$m" >> "$LOG" 2>&1 || umount -lR "$m" >> "$LOG" 2>&1; }
   done
   [ -n "$work" ] && rmdir "$work/boot" "$work/data" "$work/slot" "$work" 2>/dev/null
   [ -L /dev/root ] && [ "${made_dev_root:-0}" = 1 ] && rm -f /dev/root
   if [ $rc -ne 0 ]
   then
      echo "${c_red}Installation failed. Last lines of $LOG:${c_off}" >&2
      tail -n 15 "$LOG" >&2
   fi
   exit $rc
}

usage() {
   sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'
   cat <<EOF

Options:
  --disk DEV          disk to erase and install to (e.g. /dev/sda; at least 32 GB)
  --hostname NAME     (default: gobolinux)
  --user LOGIN        regular user to create
  --fullname "NAME"
  --timezone ZONE     (default: UTC; e.g. Europe/Warsaw)
  --keymap MAP        console keymap (default: follows --xkb)
  --xkb LAYOUT        X keyboard layout (default: same as the live session)
  --autologin         log the user in without a password
  --text-login        no graphical login screen: log in on the text console, the desktop starts after it
  --swap MB           create a swap file of this size (on the data partition)
  --firmware efi|bios install the bootloader for this firmware (default: what the live session booted with)
  --answers FILE      read settings (shell variables) from FILE
  --yes               do not ask anything; needs --disk and passwords from --answers
  --source IMAGE      install from this live image (squashfs file or unpacked folder) instead of the
                      running live session's (for development; allows running outside the live session)
EOF
}

part_dev() { # part_dev N -> partition N of $DISK
   case "$DISK" in
      *[0-9]) echo "${DISK}p$1" ;;   # nvme0n1 -> nvme0n1p1
      *)      echo "${DISK}$1" ;;
   esac
}

dev_is_mounted() { # also under GoboLinux's /System/Kernel/Devices name
   local name; name=$(basename "$(readlink -f "$1")")
   grep -qE "^(/dev|/System/Kernel/Devices)/$name " /proc/mounts && return 0
   [ -n "$(findmnt -rn -S "$1" 2>/dev/null)" ]
}

check_part() { # check_part DEV NAME: refuse unless DEV is named NAME in the new table and not in use
   local dev="$1" name="$2" got
   [ -b "$dev" ] || die "partition $dev did not appear"
   got=$(lsblk -no PARTLABEL "$dev" 2>/dev/null | head -n 1)
   [ "$got" = "$name" ] || die "$dev is named '$got', expected $name; not formatting it"
   dev_is_mounted "$dev" && die "$dev is mounted; not formatting it"
   [ "$(findmnt -rn -o SOURCE / | xargs -r readlink -f)" != "$(readlink -f "$dev")" ] || die "$dev is the running root"
   return 0
}

### Arguments ##################################################################

while [ $# -gt 0 ]
do
   case "$1" in
      --disk)      DISK="$2"; shift ;;
      --hostname)  HOSTNAME_NEW="$2"; shift ;;
      --user)      USER_NAME="$2"; shift ;;
      --fullname)  USER_FULLNAME="$2"; shift ;;
      --timezone)  TIMEZONE="$2"; shift ;;
      --keymap)    KEYMAP="$2"; shift ;;
      --xkb)       XKB_LAYOUT="$2"; shift ;;
      --swap)      SWAP_MB="$2"; shift ;;
      --firmware)  FIRMWARE="$2"; shift ;;
      --source)    SOURCE="$2"; shift ;;
      --answers)   [ -r "$2" ] || die "cannot read answers file $2"; . "$2"; shift ;;
      --autologin) AUTOLOGIN=1 ;;
      --text-login) LOGIN_SCREEN=0 ;;
      --yes)       ASSUME_YES=1 ;;
      -h|--help)   usage; exit 0 ;;
      *)           usage >&2; die "unknown option: $1" ;;
   esac
   shift
done

### Checks #####################################################################

[ "$(id -u)" = 0 ] || die "must be run as root"
if [ -z "$SOURCE" ]
then
   grep -q 'Boot=LiveCD' /proc/cmdline || die "this is not the GoboLinux live environment"
   for f in /Data/Variable/run/initramfs/live/gobolinux-live.squashfs /run/initramfs/live/gobolinux-live.squashfs
   do [ -f "$f" ] && SOURCE="$f" && break
   done
   [ -n "$SOURCE" ] || die "the live image (gobolinux-live.squashfs) was not found"
fi
[ -e "$SOURCE" ] || die "no such image: $SOURCE"
[[ "$SWAP_MB" =~ ^[0-9]+$ ]] || die "--swap needs a size in MB"
for tool in parted mkfs.ext4 mkfs.fat wipefs blkid lsblk findmnt openssl usermod grub-editenv grub-mkimage grub-install mksquashfs
do command -v $tool > /dev/null || die "required tool not found: $tool"
done

: > "$LOG"
self_dir="$(dirname "$(readlink -f "$0")")"
MAKE_SYSTEM=""
for f in "$self_dir/gobo-make-system" /Programs/GoboSpin/Current/bin/gobo-make-system
do [ -z "$MAKE_SYSTEM" ] && [ -x "$f" ] && MAKE_SYSTEM="$f"
done
[ -n "$MAKE_SYSTEM" ] || die "gobo-make-system not found (next to gobo-install or in GoboSpin)"
if [ -z "$LOOK_DIR" ]
then
   # Next to this script (development), or in the GoboSpin program's share/ (on the spin ISO).
   for d in "$self_dir/gobo11" "$self_dir/../share/gobo11"
   do [ -d "$d" ] && LOOK_DIR="$d" && break
   done
fi
for f in "$self_dir/../share/spin-version" /Programs/GoboSpin/Current/share/spin-version
do
   if [ -z "$SPIN_VERSION" ] && [ -f "$f" ]
   then SPIN_VERSION="$(head -n 1 "$f" | tr -dc '0-9A-Za-z.-')"
   fi
done
SPIN_LABEL="$SPIN_NAME${SPIN_VERSION:+ $SPIN_VERSION}"
if [ -z "${FIRMWARE:-}" ]
then [ -d /sys/firmware/efi ] && FIRMWARE=efi || FIRMWARE=bios
fi
case "$FIRMWARE" in efi|bios) ;; *) die "--firmware must be efi or bios" ;; esac

### Questions ##################################################################

ask() { # ask VAR "Prompt" [default]
   local var="$1" prompt="$2" default="${3:-}" reply
   [ -n "${!var}" ] && return 0
   if [ "$ASSUME_YES" = 1 ]
   then printf -v "$var" '%s' "$default"; return 0
   fi
   read -r -p "$prompt${default:+ [$default]}: " reply
   printf -v "$var" '%s' "${reply:-$default}"
}

ask_password() { # ask_password VAR "who"
   local var="$1" who="$2" p1 p2
   [ -n "${!var}" ] && return 0
   [ "$ASSUME_YES" != 1 ] || die "no password given for $who (set it in the --answers file)"
   while true
   do
      read -r -s -p "Password for $who: " p1; echo
      read -r -s -p "Repeat password for $who: " p2; echo
      [ -n "$p1" ] && [ "$p1" = "$p2" ] && break
      echo "Passwords are empty or do not match, try again."
   done
   printf -v "$var" '%s' "$p1"
}

if [ -z "$DISK" ]
then
   [ "$ASSUME_YES" != 1 ] || die "--yes needs --disk (refusing to pick a disk to erase by itself)"
   echo "Disks:"
   lsblk -dno NAME,SIZE,MODEL,TYPE | awk '$NF == "disk" { $NF = ""; print "  /dev/" $0 }'
   first=$(lsblk -dno NAME,TYPE | awk '$2 == "disk" { print "/dev/" $1; exit }')
   ask DISK "Disk to ERASE and install $SPIN_NAME on" "$first"
fi
[ -b "$DISK" ] || die "$DISK is not a block device"
[ "$(lsblk -dno TYPE "$DISK")" = disk ] || die "$DISK is not a whole disk"
disk_bytes=$(lsblk -bdno SIZE "$DISK")
[ "$disk_bytes" -ge "$MIN_DISK_BYTES" ] ||
   die "$DISK has $((disk_bytes / 1000000000)) GB; $SPIN_NAME needs a disk of at least 32 GB (two system slots and a data partition)"

ask USER_NAME "Login name for your user" "user"
[[ "$USER_NAME" =~ ^[a-z_][a-z0-9_-]*$ ]] || die "invalid login name: $USER_NAME"
[ "$USER_NAME" != root ] || die "the user cannot be called root"
ask USER_FULLNAME "Full name" "$USER_NAME"
ask_password USER_PASSWORD "$USER_NAME"
ask_password ROOT_PASSWORD "root (administrator)"

ask HOSTNAME_NEW "Name for this computer" "gobolinux"
[[ "$HOSTNAME_NEW" =~ ^[A-Za-z0-9][A-Za-z0-9-]*$ ]] || die "invalid computer name: $HOSTNAME_NEW"

while true
do
   ask TIMEZONE "Timezone, e.g. Europe/Warsaw" "UTC"
   [ -f "/System/Index/share/zoneinfo/$TIMEZONE" ] && break
   [ "$ASSUME_YES" != 1 ] || die "unknown timezone: $TIMEZONE"
   echo "Unknown timezone '$TIMEZONE'. Use Region/City, as listed in /System/Index/share/zoneinfo."
   TIMEZONE=""
done

live_layout=$(sed -n 's/^setxkbmap .*-layout \([a-z,]*\).*/\1/p' /Users/root/.xinitrc 2>/dev/null | head -n 1)
ask XKB_LAYOUT "Keyboard layout, e.g. us, pl, de" "${live_layout:-us}"
[[ "$XKB_LAYOUT" =~ ^[a-z,_]+$ ]] || die "invalid keyboard layout: $XKB_LAYOUT"
if [ -z "$KEYMAP" ]
then
   if find -L /System/Index/share/keymaps /Programs/KBD/Current -name "$XKB_LAYOUT.map*" 2>/dev/null | grep -q .
   then KEYMAP="$XKB_LAYOUT"
   else KEYMAP="us"
   fi
fi

data_gib=$(( (disk_bytes / 1048576 - 514 - 2 * SLOT_MIB) / 1024 ))
echo
echo "About to install $SPIN_LABEL, an unofficial spin of GoboLinux 017.01:"
echo "  disk      $DISK ($(lsblk -dno SIZE "$DISK" | tr -d ' ')) - EVERYTHING ON IT WILL BE ERASED"
echo "  layout    two system slots of $((SLOT_MIB / 1024)) GB (A and B, for updates), data partition ${data_gib} GB"
echo "  firmware  $FIRMWARE"
echo "  hostname  $HOSTNAME_NEW"
echo "  user      $USER_NAME ($USER_FULLNAME)$([ "$AUTOLOGIN" = 1 ] && echo ', automatic login')"
echo "  timezone  $TIMEZONE, keyboard $XKB_LAYOUT"
# Same test as in step 4 (there on the copied system, here on the running one).
if [ "$LOGIN_SCREEN" = 1 ] && [ -x /System/Index/sbin/lxdm-binary ] && [ -f /Programs/LXDM/Settings/lxdm/lxdm.conf ]
then
   if [ "$AUTOLOGIN" = 1 ]
   then login_method="automatic login to the desktop (graphical login screen after logging out)"
   else login_method="graphical login screen"
   fi
else
   if [ "$AUTOLOGIN" = 1 ]
   then login_method="automatic login on the text console, then the desktop starts"
   else login_method="text login on the console, then the desktop starts"
   fi
fi
echo "  login     $login_method"
[ "$SWAP_MB" -gt 0 ] && echo "  swap      ${SWAP_MB} MB swap file on the data partition"
if [ "$ASSUME_YES" != 1 ]
then
   read -r -p "Type 'yes' to continue: " reply
   [ "$reply" = yes ] || die "aborted, nothing was changed"
fi

trap cleanup EXIT
t_start=$SECONDS
work=$(mktemp -d /tmp/gobo-install.XXXXXX)
mkdir -p "$work/slot" "$work/data" "$work/boot"

### 1. Partition and format ####################################################

step "Partitioning $DISK"
umount -R "$DEST" 2>/dev/null || true
for part in $(lsblk -lno NAME "$DISK" | tail -n +2)
do umount "/dev/$part" 2>/dev/null || true
done
for part in $(lsblk -lno NAME "$DISK" | tail -n +2)
do dev_is_mounted "/dev/$part" && die "/dev/$part is still in use (the live medium?); not erasing $DISK"
done
run wipefs -a "$DISK"

a_end=$((514 + SLOT_MIB)); b_end=$((a_end + SLOT_MIB))
run parted -s "$DISK" mklabel gpt \
   mkpart BIOSBOOT 1MiB 2MiB set 1 bios_grub on \
   mkpart GOBO_BOOT fat32 2MiB 514MiB set 2 esp on \
   mkpart GOBO_A ext4 514MiB ${a_end}MiB \
   mkpart GOBO_B ext4 ${a_end}MiB ${b_end}MiB \
   mkpart GOBO_DATA ext4 ${b_end}MiB 100%
run partprobe "$DISK" || true
run udevadm settle || true
BOOT_PART=$(part_dev 2); A_PART=$(part_dev 3); B_PART=$(part_dev 4); DATA_PART=$(part_dev 5)

step "Formatting"
check_part "$BOOT_PART" GOBO_BOOT; run mkfs.fat -F 32 -n GOBO_BOOT "$BOOT_PART"
check_part "$A_PART" GOBO_A;       run mkfs.ext4 -F -q -O ^orphan_file -L GOBO_A "$A_PART"
check_part "$B_PART" GOBO_B;       run mkfs.ext4 -F -q -O ^orphan_file -L GOBO_B "$B_PART"
check_part "$DATA_PART" GOBO_DATA; run mkfs.ext4 -F -q -O ^orphan_file -L GOBO_DATA "$DATA_PART"
run udevadm settle || true

uuid()     { blkid -s UUID -o value "$1"; }
partuuid() { blkid -s PARTUUID -o value "$1"; }
UUID_BOOT=$(uuid "$BOOT_PART"); UUID_A=$(uuid "$A_PART"); UUID_B=$(uuid "$B_PART"); UUID_DATA=$(uuid "$DATA_PART")
PARTUUID_A=$(partuuid "$A_PART"); PARTUUID_B=$(partuuid "$B_PART")
for v in UUID_BOOT UUID_A UUID_B UUID_DATA PARTUUID_A PARTUUID_B
do [ -n "${!v}" ] || die "could not read $v"
done

### 2. The system: slot A ######################################################

run mount "$A_PART" "$work/slot"
step "Copying the system into slot A (this takes a few minutes)"
"$MAKE_SYSTEM" --log "$LOG" "$SOURCE" "$work/slot" || die "the system copy failed"
grub-editenv "$work/slot/gobo-slot.env" create
grub-editenv "$work/slot/gobo-slot.env" set "slot_version=${SPIN_VERSION:-unknown}"
sync
run mount -o remount,ro "$work/slot"

### 3. The data partition and the overlay ######################################

step "Preparing the data partition"
run mount "$DATA_PART" "$work/data"
mkdir -p "$work/data/System-Overlay/install" "$work/data/System-Overlay/upper" \
         "$work/data/System-Overlay/work" "$work/data/System-Overlay/work-install"
cp -a "$work/slot/Users" "$work/data/Users"
cp -a "$work/slot/Data/Variable" "$work/data/Variable"
echo "${SPIN_VERSION:-unknown}" > "$work/data/System-Overlay/booted-version"
mkdir -p "$work/data/Variable/lib/gobo-update"
echo "${SPIN_VERSION:-unknown}" > "$work/data/Variable/lib/gobo-update/slot-a"

# Assemble the new system the way its initramfs will, but with the install layer on top, so
# everything below lands in System-Overlay/install (settings) or on the data partition (homes).
mkdir -p "$DEST"
run mount -t overlay gobo-install -o "lowerdir=$work/slot,upperdir=$work/data/System-Overlay/install,workdir=$work/data/System-Overlay/work-install,redirect_dir=off,index=off,metacopy=off" "$DEST"
run mount --bind "$work/data/Users" "$DEST/Users"
run mount --bind "$work/data/Variable" "$DEST/Data/Variable"
for d in proc sys dev
do run mount --rbind /$d "$DEST/$d"
done

### 4. Configure (this computer's settings, into the overlay) ##################

step "Configuring the system"

# Boot options
bootopts="$DEST/Programs/BootScripts/Settings/BootOptions"
{
   echo "HostName=$HOSTNAME_NEW"
   echo
   sed -e "s|^KeymapLayout=.*|KeymapLayout=$KEYMAP|" \
       -e "s|^ClockMode=.*|ClockMode=$CLOCK_MODE|" \
       -e "s|^    fuse$|    fuse\n    snd-pcm-oss\n    snd-mixer-oss|" \
       "$DEST/Programs/BootScripts/Current/Resources/Defaults/Settings/BootOptions"
} > "$bootopts.new"
mv "$bootopts.new" "$bootopts"
echo "127.0.0.1 localhost.localdomain localhost $HOSTNAME_NEW" > "$DEST/System/Settings/hosts"

# fstab: "/" is put together by the initramfs (system slot + overlay), so it is not listed.
{
   cat <<EOF
# Generated by gobo-install on $(date)
# GoboRefined A/B layout: "/" = slot GOBO_A or GOBO_B (read-only) + overlay on GOBO_DATA,
# /Users and /Data/Variable from GOBO_DATA - all mounted by the initramfs, not from here.

proc      /proc                  proc      defaults 0 0
none      /sys                   sysfs     defaults 0 0
none      /sys/kernel/config     configfs  defaults 0 0
none      /dev/pts               devpts    defaults 0 0
none      /dev/shm               tmpfs     defaults 0 0
EOF
   [ "$FIRMWARE" = efi ] && echo "efivarfs  /sys/firmware/efi/efivars efivarfs defaults 0 0"
   cat <<EOF

# Bind-mounts.
/sys      /System/Kernel/Objects none      rbind    0 0
/dev      /System/Kernel/Devices none      rbind    0 0
/proc     /System/Kernel/Status  none      rbind    0 0

# Boot partition (GRUB, grubenv): mounted only when needed ("mount /System/Kernel/ESP").
UUID=$UUID_BOOT /System/Kernel/ESP vfat noauto,umask=0077 0 0
EOF
   if [ "$SWAP_MB" -gt 0 ]
   then
      echo
      echo "# Swap file (on the data partition)."
      echo "/Data/Variable/swap none swap pri=1 0 0"
   fi
} > "$DEST/System/Settings/fstab"

if [ "$SWAP_MB" -gt 0 ]
then
   step "Creating a ${SWAP_MB} MB swap file"
   run dd if=/dev/zero of="$DEST/Data/Variable/swap" bs=1M count="$SWAP_MB"
   chmod 600 "$DEST/Data/Variable/swap"
   run mkswap "$DEST/Data/Variable/swap"
fi

# Timezone
in_target ln -sfn "/System/Index/share/zoneinfo/$TIMEZONE" /Programs/Glibc/Settings/localtime
in_target ln -sfn "/System/Index/share/zoneinfo/$TIMEZONE" /System/Settings/localtime

### 5. Users ###################################################################

step "Creating users"
in_target AddUser -f "$USER_FULLNAME" -p '!' --skel "$USER_NAME"
in_target usermod -aG sys,lpadmin "$USER_NAME"     # sys = may use sudo
chroot "$DEST" visudo -c >> "$LOG" 2>&1 || die "the sudo configuration is not valid"

# Passwords are hashed here and written with usermod: chpasswd on 017.01
# exits 0 without changing anything. (Not logged, so hashes stay out of $LOG.)
set_password() { # set_password LOGIN PASSWORD
   local hash
   hash=$(printf '%s' "$2" | openssl passwd -6 -stdin) || die "could not hash the password for $1"
   chroot "$DEST" usermod -p "$hash" "$1" >> "$LOG" 2>&1 || die "could not set the password for $1"
   grep -q "^$1:\\\$6\\\$" "$DEST/System/Settings/shadow" || die "password for $1 was not stored"
}
set_password root "$ROOT_PASSWORD"
set_password "$USER_NAME" "$USER_PASSWORD"
rm -f "$DEST/Users/$USER_NAME/Desktop/Manager.desktop"

# Desktop session: same .xinitrc as the live session, with the chosen keyboard.
for login in root "$USER_NAME"
do
   for rc in .xinitrc .Xresources
   do
      [ -e "/Users/root/$rc" ] || continue
      cp "/Users/root/$rc" "$DEST/Users/$login/$rc"
      in_target chown "$login" "/Users/$login/$rc"
   done
   [ -e "$DEST/Users/$login/.xinitrc" ] &&
      sed -i "s|^setxkbmap .*|setxkbmap -model pc104 -layout $XKB_LAYOUT|" "$DEST/Users/$login/.xinitrc"
done

# The modern look, if it is available next to the installer.
if [ -f "$LOOK_DIR/apply.sh" ]
then
   step "Applying the desktop look"
   for login in root "$USER_NAME"
   do
      run sh "$LOOK_DIR/apply.sh" "$DEST/Users/$login" "$XKB_LAYOUT"
      in_target chown -R "$login" "/Users/$login/.config" "/Users/$login/.xinitrc" "/Users/$login/.Xresources" "/Users/$login/.urxvt"
      # standard folders created by apply.sh (0.6): Documents, Downloads, Music, Pictures, Videos;
      # Desktop holds the Trash icon (Trash.desktop), .config the marker gobo11-trash-icon
      for d in Desktop Documents Downloads Music Pictures Videos
      do
         if [ -d "$DEST/Users/$login/$d" ]; then in_target chown -R "$login" "/Users/$login/$d"; fi
      done
   done
fi

# How the desktop starts. With the spin's login screen (LXDM, started by init
# on tty7) the user logs in graphically. Without it - older image, or
# --text-login - the user logs in on the first text console and the desktop
# starts from the shell (the stock "Graphic" boot script wants kdm, which is
# not on the image).
inittab="$DEST/Programs/BootScripts/Settings/inittab"
lxdm_conf="$DEST/Programs/LXDM/Settings/lxdm/lxdm.conf"
[ -x "$DEST/System/Index/sbin/lxdm-binary" ] && [ -f "$lxdm_conf" ] || LOGIN_SCREEN=0

if [ "$LOGIN_SCREEN" = 1 ]
then
   step "Enabling the graphical login screen"
   grep -q 'lxdm-binary' "$inittab" || cat >> "$inittab" <<'EOF'

# Added by gobo-install: graphical login screen (LXDM) on tty7.
x:2345:respawn:/System/Index/sbin/lxdm-binary
EOF
   # The login screen runs before the user's own keyboard setting applies.
   if [ "$XKB_LAYOUT" != us ]
   then
      mkdir -p "$DEST/System/Settings/X11/xorg.conf.d"
      cat > "$DEST/System/Settings/X11/xorg.conf.d/00-keyboard.conf" <<EOF
# Written by gobo-install: keyboard layout for the login screen.
Section "InputClass"
   Identifier "keyboard"
   MatchIsKeyboard "on"
   Option "XkbLayout" "$XKB_LAYOUT"
EndSection
EOF
   fi
   if [ "$AUTOLOGIN" = 1 ]
   then
      sed -i "s|^# *autologin=.*|autologin=$USER_NAME|" "$lxdm_conf"
      grep -q "^autologin=$USER_NAME\$" "$lxdm_conf" || die "could not set automatic login in $lxdm_conf"
   fi
else
   cat >> "$DEST/Users/$USER_NAME/.zlogin" <<'EOF'

# Added by gobo-install: start the desktop when logging in on the first console.
# (On GoboLinux the console is reported as /System/Kernel/Devices/tty1.)
# When the desktop is closed ("Log out"), leave the console too, so the next
# person gets a login prompt. If X stops within seconds it probably failed:
# stay in the shell then, so the problem can be looked at.
case "$DISPLAY:$(tty)" in
   :*/tty1)
      started=$SECONDS
      startx
      [ $((SECONDS - started)) -gt 20 ] && logout
      ;;
esac
EOF
   in_target chown "$USER_NAME" "/Users/$USER_NAME/.zlogin"

   if [ "$AUTOLOGIN" = 1 ]
   then
      sed -i "s|^1:2345:respawn:.*|1:2345:respawn:/System/Index/bin/agetty --autologin $USER_NAME --noclear tty1 9600|" \
         "$inittab"
   fi
fi

step "Closing the system"
sync
for d in proc sys dev
do umount -R "$DEST/$d" >> "$LOG" 2>&1 || umount -lR "$DEST/$d" >> "$LOG" 2>&1 || true
done
umount "$DEST/Data/Variable" "$DEST/Users" >> "$LOG" 2>&1
umount "$DEST" >> "$LOG" 2>&1 || die "could not unmount the new system"

### 6. Bootloader (on GOBO_BOOT) ###############################################

step "Installing the GRUB bootloader ($FIRMWARE)"
run mount -t vfat "$BOOT_PART" "$work/boot"
grubdir="$work/boot/grub"
mkdir -p "$grubdir"
if [ "$FIRMWARE" = efi ]
then
   # grub-install cannot be used here: with GoboLinux's /System/Kernel/Devices it fails to
   # detect the partition table and produces a loader that cannot read the disk. Build the
   # loader image directly instead, with a small embedded script that finds the boot
   # partition by UUID. It goes to the removable-media path, which firmware boots without
   # needing a boot entry.
   moddir="$work/slot/Programs/GRUB-EFI/Current/lib/grub/x86_64-efi"
   [ -d "$moddir" ] || die "GRUB EFI modules not found in $moddir"
   mkdir -p "$grubdir/x86_64-efi" "$work/boot/EFI/BOOT"
   cp "$moddir"/*.mod "$moddir"/*.lst "$grubdir/x86_64-efi/"
   cat > "$work/grub-early.cfg" <<EOF
search --no-floppy --fs-uuid --set=root $UUID_BOOT
set prefix=(\$root)/grub
configfile \$prefix/grub.cfg
EOF
   echo "+ grub-mkimage (efi)" >> "$LOG"
   grub-mkimage -d "$moddir" -O x86_64-efi \
      -o "$work/boot/EFI/BOOT/BOOTX64.EFI" -c "$work/grub-early.cfg" -p /grub \
      part_gpt part_msdos fat ext2 normal configfile search search_fs_uuid linux loadenv \
      test echo sleep all_video efi_gop efi_uga gfxterm font ls >> "$LOG" 2>&1 || die "grub-mkimage failed"
   rm -f "$work/grub-early.cfg"
   [ -s "$work/boot/EFI/BOOT/BOOTX64.EFI" ] || die "the EFI loader was not written"
   # Also register a named boot entry where the firmware allows it (optional).
   run efibootmgr -c -d "$DISK" -p 2 -L GoboLinux -l '\EFI\BOOT\BOOTX64.EFI' || true
   video="insmod all_video"
else
   # GRUB's core image goes into the BIOS boot partition (1), its files to GOBO_BOOT.
   if [ ! -e /dev/root ]
   then ln -s "$A_PART" /dev/root; made_dev_root=1
   fi
   echo "+ grub-install (bios)" >> "$LOG"
   timeout 300 grub-install --target=i386-pc --no-floppy --boot-directory="$work/boot" \
      --modules="part_gpt fat ext2 biosdisk search search_fs_uuid normal configfile loadenv test" \
      "$DISK" >> "$LOG" 2>&1 || die "grub-install failed"
   [ -f "$grubdir/i386-pc/normal.mod" ] || die "GRUB's BIOS modules were not installed"
   video="insmod vbe"
fi

step "Writing the boot menu"
cat > "$grubdir/grub.cfg" <<EOF
# Written by gobo-install: GoboRefined A/B boot menu. Static; gobo-update only changes grubenv
# (slot = the default slot, try_slot/tries_left = a new slot being tried, rollback_from =
# a new slot whose tries ran out). The gobo_* lines are read by gobo-update as well.
set gobo_uuid_boot=$UUID_BOOT
set gobo_uuid_a=$UUID_A
set gobo_uuid_b=$UUID_B
set gobo_uuid_data=$UUID_DATA
set gobo_partuuid_a=$PARTUUID_A
set gobo_partuuid_b=$PARTUUID_B
set gobo_args="vt.default_utf8=1 rootwait net.ifnames=0"

set timeout=5
insmod part_gpt
insmod fat
insmod ext2
insmod loadenv
insmod test
$video

load_env -f \$prefix/grubenv

# What each slot holds (gobo-slot.env is written last when a slot is filled).
set ver_a=""
set ver_b=""
if search --no-floppy --fs-uuid --set=dev_a \$gobo_uuid_a; then
   if [ -f (\$dev_a)/gobo-slot.env ]; then
      set slot_version="?"
      load_env -f (\$dev_a)/gobo-slot.env slot_version
      set ver_a="\$slot_version"
   fi
fi
if search --no-floppy --fs-uuid --set=dev_b \$gobo_uuid_b; then
   if [ -f (\$dev_b)/gobo-slot.env ]; then
      set slot_version="?"
      load_env -f (\$dev_b)/gobo-slot.env slot_version
      set ver_b="\$slot_version"
   fi
fi

# Which slot starts: the default, or a new one for at most two tries.
if [ "\$slot" != b ]; then set slot=a; fi
set boot_slot=\$slot
set try_args=""
if [ "\$try_slot" = a -o "\$try_slot" = b ]; then
   if [ "\$tries_left" = 2 ]; then
      set tries_left=1
      save_env -f \$prefix/grubenv tries_left
      set boot_slot=\$try_slot
   elif [ "\$tries_left" = 1 ]; then
      set tries_left=0
      save_env -f \$prefix/grubenv tries_left
      set boot_slot=\$try_slot
   else
      set rollback_from=\$try_slot
      set try_slot=""
      set tries_left=""
      save_env -f \$prefix/grubenv rollback_from try_slot tries_left
   fi
fi
if [ "\$boot_slot" = a -a -z "\$ver_a" ]; then set boot_slot=b; fi
if [ "\$boot_slot" = b -a -z "\$ver_b" ]; then set boot_slot=a; fi
if [ -n "\$try_slot" -a "\$boot_slot" = "\$try_slot" ]; then
   # A slot that does not start reboots (instead of waiting at a prompt), so the tries run out.
   set try_args="rd.shell=0 rd.emergency=reboot panic=10"
   set fallback="slot-\$slot"
fi
set default="slot-\$boot_slot"
export dev_a dev_b gobo_uuid_a gobo_uuid_b gobo_uuid_data gobo_uuid_boot gobo_args try_slot try_args

function gobo_boot {
   if [ "\$1" = a ]; then set d=\$dev_a; set u=\$gobo_uuid_a; else set d=\$dev_b; set u=\$gobo_uuid_b; fi
   set x=""
   if [ "\$1" = "\$try_slot" ]; then set x="\$try_args"; fi
   echo "Starting GoboRefined from slot \$1 ..."
   linux (\$d)/System/Kernel/Boot/kernel root=gobo gobo.slot=\$1 gobo.root=UUID=\$u gobo.data=UUID=\$gobo_uuid_data gobo.boot=UUID=\$gobo_uuid_boot \$gobo_args \$x \$2 \$3
   initrd (\$d)/System/Kernel/Boot/initramfs
}

if [ -n "\$ver_a" ]; then
   menuentry "GoboRefined \$ver_a (slot A)" --id slot-a { gobo_boot a }
   menuentry "GoboRefined \$ver_a (slot A) - without my system changes" --id slot-a-pristine { gobo_boot a gobo.system-changes=off }
   menuentry "GoboRefined \$ver_a (slot A) - safe graphics" --id slot-a-safe { gobo_boot a nomodeset }
else
   menuentry "Slot A: empty" --id empty-a { echo "Slot A is empty or incomplete. A system update fills it."; sleep 5 }
fi
if [ -n "\$ver_b" ]; then
   menuentry "GoboRefined \$ver_b (slot B)" --id slot-b { gobo_boot b }
   menuentry "GoboRefined \$ver_b (slot B) - without my system changes" --id slot-b-pristine { gobo_boot b gobo.system-changes=off }
   menuentry "GoboRefined \$ver_b (slot B) - safe graphics" --id slot-b-safe { gobo_boot b nomodeset }
else
   menuentry "Slot B: empty" --id empty-b { echo "Slot B is empty. The first system update (gobo-update) fills it."; sleep 5 }
fi
EOF
grub-editenv "$grubdir/grubenv" create
grub-editenv "$grubdir/grubenv" set slot=a
sync

### Done #######################################################################

step "Unmounting"
sync
trap - EXIT
umount "$work/boot" "$work/data" "$work/slot" >> "$LOG" 2>&1 || true
rmdir "$work/boot" "$work/data" "$work/slot" "$work" 2>/dev/null || true
[ "${made_dev_root:-0}" = 1 ] && rm -f /dev/root
echo "+ install time $((SECONDS - t_start)) s" >> "$LOG"

echo
echo "${c_cyan}$SPIN_NAME is installed on $DISK (system slot A; slot B is filled by the first update).${c_off}"
if [ "$AUTOLOGIN" = 1 ]
then echo "Remove the installation medium and reboot. The desktop starts by itself (automatic login as '$USER_NAME')."
elif [ "$LOGIN_SCREEN" = 1 ]
then echo "Remove the installation medium and reboot, then log in as '$USER_NAME' on the login screen."
else echo "Remove the installation medium and reboot. Log in as '$USER_NAME' on the text console and the desktop starts."
fi
echo "Full log: $LOG"
