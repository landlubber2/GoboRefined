#!/bin/bash
# gobo-install-btrfs-proto — PROTOTYPE of the 0.10 btrfs layout (docs/ab-btrfs-plan.md, phase 1).
# May be thrown away; the real installer work is phase 2 (gobo-install).
#
# Makes a whole disk into the btrfs A/B layout and puts one system version on it:
#   1 BIOSBOOT  1 MiB     GRUB core on BIOS
#   2 GOBO_BOOT 1 GiB     FAT32 (EFI system partition): GRUB, grub.cfg, grubenv,
#                         gobo/a/{kernel,initramfs,gobo-slot.env} (and gobo/b/ after an update)
#   3 GOBO_POOL rest      btrfs, compress=zstd:3: subvolumes @system-a (read-only), @data, @swap
#
#   sudo gobo-install-btrfs-proto --disk DEV --update FILE.update --data-from DIR [options]
#
#   --disk DEV          the WHOLE disk to erase (must not hold the running system or anything mounted)
#   --update FILE       a signed GoboRefined-<v>.update file: its squashfs becomes @system-a
#   --data-from DIR     a GOBO_DATA tree to copy into @data (System-Overlay/{install,upper}, Users,
#                       Variable), e.g. /System/Data of the running system: the prototype takes this
#                       machine's accounts and settings instead of asking (the real installer asks)
#   --dracut-module DIR the 90goboab dracut module with the btrfs path (spin/ab/dracut/90goboab);
#                       the update's own initramfs predates it, so a new one is made (prototype only)
#   --grub-template F   spin/ab/grub-btrfs.cfg.in
#   --swap MB           swap file in @swap (default 1024; 0 = none)
#   --firmware efi|bios (default: what this computer started with)
#   --yes               do not ask before erasing
#
# Timings go to the log (/Data/Variable/log/gobo-install-btrfs-proto.log).

set -euo pipefail

DISK="" UPDATE="" DATA_FROM="" DRACUT_MOD="" GRUB_TPL="" SWAP_MB=1024 FIRMWARE="" ASSUME_YES=0
MIN_DISK_BYTES=32000000000
PUBKEY=/Programs/GoboSpin/Current/share/gobo-update/update-signing.pub.pem
TRAILER_SIZE=8192
LOG=/Data/Variable/log/gobo-install-btrfs-proto.log
MOUNT_OPTS=noatime,compress=zstd:3

c_cyan=$'\033[1;36m'; c_red=$'\033[1;31m'; c_off=$'\033[0m'
[ -t 1 ] || { c_cyan=""; c_red=""; c_off=""; }
T0=$SECONDS
step() { echo "${c_cyan}==> $*${c_off}"; echo "$(date '+%F %T') [+$((SECONDS - T0)) s] ==> $*" >> "$LOG"; }
die()  { echo "${c_red}gobo-install-btrfs-proto: $*${c_off}" >&2; echo "ERROR: $*" >> "$LOG"; exit 1; }
run()  { echo "+ $*" >> "$LOG"; "$@" >> "$LOG" 2>&1; }

while [ $# -gt 0 ]
do
   case "$1" in
      --disk) DISK="$2"; shift ;;
      --update) UPDATE="$2"; shift ;;
      --data-from) DATA_FROM="$2"; shift ;;
      --dracut-module) DRACUT_MOD="$2"; shift ;;
      --grub-template) GRUB_TPL="$2"; shift ;;
      --swap) SWAP_MB="$2"; shift ;;
      --firmware) FIRMWARE="$2"; shift ;;
      --yes) ASSUME_YES=1 ;;
      -h|--help) sed -n '2,28p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
      *) die "unknown argument '$1' (see --help)" ;;
   esac
   shift
done

### Checks (before anything touches a disk) ####################################

[ "$(id -u)" = 0 ] || die "must be run as root"
mkdir -p "${LOG%/*}"; : > "$LOG"; chmod 600 "$LOG"
[[ "$SWAP_MB" =~ ^[0-9]+$ ]] || die "--swap needs a size in MB"
[ -n "$FIRMWARE" ] || { [ -d /sys/firmware/efi ] && FIRMWARE=efi || FIRMWARE=bios; }
case "$FIRMWARE" in efi|bios) ;; *) die "--firmware must be efi or bios" ;; esac
for tool in parted mkfs.fat mkfs.btrfs btrfs rsync unsquashfs wipefs blkid lsblk findmnt openssl grub-editenv grub-mkimage grub-install chroot
do command -v $tool > /dev/null || die "required tool not found: $tool"
done
[[ "$DISK" =~ ^/dev/[a-z0-9]+$ ]] || die "--disk must be a disk like /dev/sdb"
[ -b "$DISK" ] && [ "$(lsblk -dno TYPE "$DISK")" = disk ] || die "$DISK is not a whole disk"
[ "$(lsblk -bdno SIZE "$DISK")" -ge "$MIN_DISK_BYTES" ] || die "$DISK is smaller than 32 GB"
[ -f "$UPDATE" ] || die "--update FILE missing"
[ -d "$DATA_FROM/System-Overlay/install" ] && [ -d "$DATA_FROM/Users" ] && [ -d "$DATA_FROM/Variable" ] ||
   die "--data-from must be a GOBO_DATA tree (System-Overlay/install, Users, Variable)"
[ -f "$DRACUT_MOD/goboab-root.sh" ] && grep -q 'LAYOUT' "$DRACUT_MOD/goboab-root.sh" || die "--dracut-module: no btrfs-aware goboab-root.sh in '$DRACUT_MOD'"
[ -f "$GRUB_TPL" ] && head -n 1 "$GRUB_TPL" | grep -q '^# gobo-grub-template ' && grep -q '@UUID_POOL@' "$GRUB_TPL" || die "--grub-template: not the btrfs template"
# The disk must not hold anything in use: the running system (its slot, data, boot partition),
# the data tree we copy from, or any mounted partition.
disk_name=$(basename "$(readlink -f "$DISK")")
for m in / /System/Slot /System/Data "$DATA_FROM" "$(dirname "$(readlink -f "$UPDATE")")"
do
   src=$(findmnt -rn -o SOURCE -T "$m" 2>/dev/null | head -n 1 | sed 's/\[.*//')
   [ -b "$src" ] || continue
   pk=$(lsblk -no PKNAME "$src" 2>/dev/null | head -n 1)
   [ "$pk" != "$disk_name" ] && [ "$(basename "$(readlink -f "$src")")" != "$disk_name" ] || die "$DISK holds $m (in use); refusing"
done
for part in $(lsblk -lno NAME "$DISK" | tail -n +2)
do grep -qE "^(/dev|/System/Kernel/Devices)/$part " /proc/mounts && die "/dev/$part is mounted; refusing to erase $DISK"
done
grep -qE "^(/dev|/System/Kernel/Devices)/$disk_name " /proc/mounts && die "$DISK is mounted; refusing"
grep -qw btrfs /proc/filesystems || modprobe btrfs || die "the kernel has no btrfs"

# The update file: signature and checksum (same format as gobo-update).
step "Checking $UPDATE"
tmpd=$(mktemp -d /tmp/gobo-btrfs-proto.XXXXXX)
work=$tmpd
cleanup() {
   set +e
   for m in "$work/sq" "$work/tree/System/Kernel/Devices" "$work/tree/System/Kernel/Objects" "$work/tree/sys" "$work/tree/System/Kernel/Status" "$work/boot" "$work/pool"
   do mountpoint -q "$m" 2>/dev/null && { umount -R "$m" 2>/dev/null || umount -lR "$m"; }
   done
   [ -n "${LOOP:-}" ] && losetup -d "$LOOP" 2>/dev/null
   rm -rf "$tmpd"
}
trap cleanup EXIT
size=$(stat -L -c %s "$UPDATE")
tail -c $TRAILER_SIZE "$UPDATE" > "$tmpd/trailer"
[ "$(head -n 1 "$tmpd/trailer" | tr -d '\000')" = "GOBOREFINED-UPDATE 1" ] || die "not a GoboRefined update file"
sed '/^-----BEGIN SIGNATURE-----$/,$d' "$tmpd/trailer" > "$tmpd/manifest"
sed -n '/^-----BEGIN SIGNATURE-----$/,/^-----END SIGNATURE-----$/p' "$tmpd/trailer" | sed '1d;$d' | openssl base64 -d -A > "$tmpd/sig"
openssl dgst -sha256 -verify "$PUBKEY" -signature "$tmpd/sig" "$tmpd/manifest" > /dev/null 2>&1 || die "bad signature"
mf() { sed -n "s/^$1=//p" "$tmpd/manifest" | head -n 1; }
U_VERSION=$(mf version); U_IMAGE_SIZE=$(mf image_size)
[[ "$U_VERSION" =~ ^[0-9A-Za-z.-]+$ ]] && [[ "$U_IMAGE_SIZE" =~ ^[0-9]+$ ]] || die "bad manifest"
[ "$size" -eq $((U_IMAGE_SIZE + TRAILER_SIZE)) ] || die "wrong file size"
[ "$(head -c "$U_IMAGE_SIZE" "$UPDATE" | sha256sum | cut -d' ' -f1)" = "$(mf image_sha256)" ] || die "checksum mismatch"
echo "    GoboRefined $U_VERSION, signature and checksum correct"

echo "$DISK: $(lsblk -dno SIZE,MODEL "$DISK" | tr -s ' ') will be ERASED (btrfs layout prototype, GoboRefined $U_VERSION)."
if [ "$ASSUME_YES" != 1 ]
then
   read -r -p "Type 'erase' to continue: " reply
   [ "$reply" = erase ] || die "nothing was changed"
fi

### 1. Partition and format ####################################################

step "Partitioning $DISK"
run wipefs -a "$DISK"
run parted -s "$DISK" mklabel gpt \
   mkpart BIOSBOOT 1MiB 2MiB set 1 bios_grub on \
   mkpart GOBO_BOOT fat32 2MiB 1026MiB set 2 esp on \
   mkpart GOBO_POOL btrfs 1026MiB 100%
run partprobe "$DISK" || true
run udevadm settle || true
case "$DISK" in *[0-9]) p=${DISK}p ;; *) p=$DISK ;; esac
BOOT_PART=${p}2 POOL_PART=${p}3
for x in "$BOOT_PART:GOBO_BOOT" "$POOL_PART:GOBO_POOL"
do
   d=${x%%:*} n=${x#*:}
   [ -b "$d" ] || die "partition $d did not appear"
   [ "$(lsblk -no PARTLABEL "$d" | head -n 1)" = "$n" ] || die "$d is not named $n; not formatting it"
done
step "Formatting"
run mkfs.fat -F 32 -n GOBO_BOOT "$BOOT_PART"
run mkfs.btrfs -f -L GOBO_POOL "$POOL_PART"
run udevadm settle || true
UUID_BOOT=$(blkid -s UUID -o value "$BOOT_PART"); UUID_POOL=$(blkid -s UUID -o value "$POOL_PART")
PARTUUID_POOL=$(blkid -s PARTUUID -o value "$POOL_PART")
[ -n "$UUID_BOOT" ] && [ -n "$UUID_POOL" ] && [ -n "$PARTUUID_POOL" ] || die "could not read the new IDs"

mkdir -p "$work/pool" "$work/boot" "$work/sq"
run mount -t btrfs -o "subvolid=5,$MOUNT_OPTS" "$POOL_PART" "$work/pool"
run mount -t vfat "$BOOT_PART" "$work/boot"
for s in @system-a @data @swap
do run btrfs subvolume create "$work/pool/$s"
done

### 2. The system: @system-a ##################################################

step "Unpacking GoboRefined $U_VERSION into @system-a"
t=$SECONDS
LOOP=$(losetup -r -f --show --sizelimit "$U_IMAGE_SIZE" "$UPDATE")
run mount -t squashfs -o ro "$LOOP" "$work/sq"
# rsync (not unsquashfs): the same copy the update uses, so the numbers compare
run rsync -aHAX --numeric-ids "$work/sq/" "$work/pool/@system-a/"
umount "$work/sq"; losetup -d "$LOOP"; LOOP=""
echo "+ unpack $((SECONDS - t)) s" >> "$LOG"
T=$work/pool/@system-a
for f in System/Kernel/Boot/kernel System/Kernel/Boot/initramfs Programs/GoboSpin/Current/share/spin-version
do [ -e "$T/$f" ] || [ -L "$T/$f" ] || die "the new system has no $f"
done
[ "$(head -n 1 "$T/Programs/GoboSpin/Current/share/spin-version" | tr -dc '0-9A-Za-z.-')" = "$U_VERSION" ] || die "version mismatch"

# PROTOTYPE ONLY: the image's initramfs has no btrfs path yet. Put the btrfs-aware 90goboab into
# this tree and make a new initramfs with the tree's own dracut (as spin/build-iso.sh does).
step "Making an initramfs with the btrfs-aware goboab module (prototype only)"
t=$SECONDS
work_tree() { # make_initramfs TREE OUT
   local R="$1" out="$2" mod KREL
   mod="$R/Programs/GoboSpin/Current/share/gobo-update/dracut/90goboab"
   [ -d "$mod" ] || die "no 90goboab in the new system"
   cp "$DRACUT_MOD"/*.sh "$mod/" && chmod 755 "$mod"/*.sh
   KREL=$(ls "$R/Programs/Linux/Current/lib/modules" | head -n 1)
   [[ "$KREL" =~ ^[0-9.]+-Gobo$ ]] || die "kernel release not found in the new system"
   mount -t proc proc "$R/System/Kernel/Status"
   mount --rbind /dev "$R/System/Kernel/Devices" && mount --make-rslave "$R/System/Kernel/Devices"
   mount --rbind /sys "$R/System/Kernel/Objects" && mount --make-rslave "$R/System/Kernel/Objects"
   # glibc 2.38 + dracut 103: /sys must be a real folder during the run (see spin/build-iso.sh)
   [ "$(readlink "$R/sys")" = System/Kernel/Objects ] || die "unexpected /sys in the new system"
   rm "$R/sys" && mkdir "$R/sys" && mount --rbind /sys "$R/sys" && mount --make-rslave "$R/sys"
   mkdir -p "$R/Data/Variable/tmp"
   chroot "$R" dracut --kver "$KREL" --force --no-hostonly --early-microcode -L 4 --add goboab /Data/Variable/tmp/gobo-proto-initramfs.img >> "$LOG" 2>&1 ||
      { tail -n 20 "$LOG"; die "dracut failed"; }
   umount -R "$R/sys" && rmdir "$R/sys" && ln -s System/Kernel/Objects "$R/sys"
   umount -R "$R/System/Kernel/Objects"; umount -R "$R/System/Kernel/Devices"; umount "$R/System/Kernel/Status"
   [ "$(readlink "$R/sys")" = System/Kernel/Objects ] || die "/sys link not restored"
   mv "$R/Data/Variable/tmp/gobo-proto-initramfs.img" "$out"
}
mkdir -p "$work/boot/gobo/a"
work_tree "$T" "$work/boot/gobo/a/initramfs.new"
kpath=$(chroot "$T" readlink -f /System/Kernel/Boot/kernel)
case "$kpath" in /Programs/Linux/*|/System/Kernel/Boot/kernel-*) ;; *) die "kernel link points to '$kpath'" ;; esac
cp "$T$kpath" "$work/boot/gobo/a/kernel.new"
sync
mv "$work/boot/gobo/a/kernel.new" "$work/boot/gobo/a/kernel"
mv "$work/boot/gobo/a/initramfs.new" "$work/boot/gobo/a/initramfs"
echo "+ initramfs + kernel $((SECONDS - t)) s" >> "$LOG"

grub-editenv "$T/gobo-slot.env" create
grub-editenv "$T/gobo-slot.env" set "slot_version=$U_VERSION"
sync
run btrfs property set -ts "$T" ro true

### 3. @data and @swap #########################################################

step "Copying the data tree into @data"
t=$SECONDS
# not copied: the overlay's work folders (scratch of overlayfs) and old update files in tmp
run rsync -aHAX --numeric-ids --exclude '/System-Overlay/work/*' --exclude '/System-Overlay/work-install/*' \
   --exclude '/Variable/tmp/GoboRefined-*.update' --exclude '/lost+found' "$DATA_FROM/" "$work/pool/@data/"
mkdir -p "$work/pool/@data/System-Overlay/work"
echo "+ data copy $((SECONDS - t)) s" >> "$LOG"
# fstab (the topmost overlay copy): boot partition by its new UUID; @swap mounted, swap file in it
D=$work/pool/@data/System-Overlay
fstab=$D/upper/System/Settings/fstab
[ -f "$fstab" ] || fstab=$D/install/System/Settings/fstab
[ -f "$fstab" ] || die "no fstab in the data tree"
sed -i -e "s|^UUID=[0-9A-Fa-f-]* /System/Kernel/ESP |UUID=$UUID_BOOT /System/Kernel/ESP |" \
       -e '/ swap /d' -e '/^# Swap file/d' -e '/subvol=@swap/d' "$fstab"
if [ "$SWAP_MB" -gt 0 ]
then
   rm -f "$work/pool/@data/Variable/swap"
   mkdir -p "$work/pool/@data/Variable/swap"
   run btrfs filesystem mkswapfile --size "${SWAP_MB}m" "$work/pool/@swap/swapfile"
   {
      echo
      echo "# btrfs layout (prototype): the initramfs mounts subvolume @swap at /Data/Variable/swap"
      echo "/Data/Variable/swap/swapfile none swap pri=1 0 0"
   } >> "$fstab"
fi
echo "$U_VERSION" > "$work/pool/@data/Variable/lib/gobo-update/slot-a"
rm -f "$work/pool/@data/Variable/lib/gobo-update/slot-b"

### 4. Bootloader (GOBO_BOOT) ##################################################

step "Installing GRUB ($FIRMWARE)"
grubdir=$work/boot/grub
mkdir -p "$grubdir"
if [ "$FIRMWARE" = efi ]
then
   moddir=$T/Programs/GRUB-EFI/Current/lib/grub/x86_64-efi
   [ -d "$moddir" ] || die "GRUB EFI modules not found"
   mkdir -p "$grubdir/x86_64-efi" "$work/boot/EFI/BOOT"
   cp "$moddir"/*.mod "$moddir"/*.lst "$grubdir/x86_64-efi/"
   printf 'search --no-floppy --fs-uuid --set=root %s\nset prefix=($root)/grub\nconfigfile $prefix/grub.cfg\n' "$UUID_BOOT" > "$tmpd/early.cfg"
   run grub-mkimage -d "$moddir" -O x86_64-efi -o "$work/boot/EFI/BOOT/BOOTX64.EFI" -c "$tmpd/early.cfg" -p /grub \
      part_gpt part_msdos fat normal configfile search search_fs_uuid linux loadenv test echo sleep all_video efi_gop efi_uga gfxterm font ls ||
      die "grub-mkimage failed"
   # a named boot entry, first in the boot order (the lab VM uses it to start this disk)
   run efibootmgr -c -d "$DISK" -p 2 -L "GoboRefined btrfs" -l '\EFI\BOOT\BOOTX64.EFI' || echo "    (no EFI boot entry made)"
   video="insmod all_video"
else
   # NOT TESTED in the prototype (the lab VM starts with UEFI)
   made_root=0
   [ -e /dev/root ] || { ln -s "$BOOT_PART" /dev/root; made_root=1; }
   timeout 300 grub-install --target=i386-pc --no-floppy --boot-directory="$work/boot" \
      --modules="part_gpt fat biosdisk search search_fs_uuid normal configfile loadenv test" "$DISK" >> "$LOG" 2>&1 || die "grub-install failed"
   [ "$made_root" = 1 ] && rm -f /dev/root
   video="insmod vbe"
fi
sed -e "s|@UUID_BOOT@|$UUID_BOOT|g" -e "s|@UUID_POOL@|$UUID_POOL|g" -e "s|@PARTUUID_POOL@|$PARTUUID_POOL|g" \
    -e "s|@VIDEO@|$video|g" "$GRUB_TPL" > "$grubdir/grub.cfg.new"
! grep -qE '@[A-Z_]+@' "$grubdir/grub.cfg.new" || die "unfilled placeholders in grub.cfg"
command -v grub-script-check > /dev/null && { grub-script-check "$grubdir/grub.cfg.new" >> "$LOG" 2>&1 || die "grub.cfg syntax"; }
mv "$grubdir/grub.cfg.new" "$grubdir/grub.cfg"
grub-editenv "$grubdir/grubenv" create
grub-editenv "$grubdir/grubenv" set slot=a
# written last: GRUB offers version A from now on
grub-editenv "$work/boot/gobo/a/gobo-slot.env.new" create
grub-editenv "$work/boot/gobo/a/gobo-slot.env.new" set "slot_version=$U_VERSION"
sync
mv "$work/boot/gobo/a/gobo-slot.env.new" "$work/boot/gobo/a/gobo-slot.env"
sync

step "Space"
{
   btrfs filesystem usage -b "$work/pool" | sed -n '1,12p'
   btrfs filesystem du -s "$work/pool/@system-a" "$work/pool/@data" "$work/pool/@swap"
   du -sh --apparent-size "$work/pool/@system-a"
   df -h "$work/boot" | tail -n 1
} | tee -a "$LOG"
step "Done in $((SECONDS - T0)) s: GoboRefined $U_VERSION on $DISK (btrfs layout prototype)"
