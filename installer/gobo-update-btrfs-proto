#!/bin/bash
# gobo-update-btrfs-proto — PROTOTYPE of gobo-update for the 0.10 btrfs layout (docs/ab-btrfs-plan.md,
# phase 1). May be thrown away; phase 2 puts this path into spin/ab/gobo-update.
#
#   sudo gobo-update-btrfs-proto FILE.update [--dracut-module DIR] [--checksum]
#   sudo gobo-update-btrfs-proto --status
#   sudo gobo-update-btrfs-proto --rollback
#
# Update (version X runs, Y is the other one):
#   1. verify the file (signature, checksum; read through one open file descriptor)
#   2. GOBO_BOOT/gobo/Y/gobo-slot.env removed first (GRUB stops offering Y), grubenv never points at Y
#   3. delete subvolume @system-Y, snapshot @system-X as @system-Y (writable; shares every file)
#   4. mount the update's squashfs, free-space check (rsync dry run: bytes to write + 2 GiB),
#      rsync -aHAX --delete into @system-Y: unchanged files (same size and time) are not touched and
#      stay shared with X; changed ones are written new
#   5. (prototype only) a new initramfs with the btrfs-aware 90goboab (--dracut-module)
#   6. kernel + initramfs to GOBO_BOOT/gobo/Y/, gobo-slot.env into @system-Y, @system-Y read-only,
#      GOBO_BOOT/gobo/Y/gobo-slot.env written last, then try_slot=Y tries_left=2 in grubenv
# A power cut before the last two writes leaves Y not offered; X is never written.
# The boot task that marks Y good after a successful start is the image's own gobo-update --boot-task
# (it only needs grubenv and the gobo_* lines of grub.cfg).
# --checksum: rsync compares contents instead of size+time (slower; more files stay shared).

set -euo pipefail

PUBKEY=/Programs/GoboSpin/Current/share/gobo-update/update-signing.pub.pem
STATE=/Data/Variable/lib/gobo-update
LOG=/Data/Variable/log/gobo-update-btrfs-proto.log
TRAILER_SIZE=8192
MOUNT_OPTS=noatime,compress=zstd:3
MARGIN=$((2 * 1024 * 1024 * 1024))
DRACUT_MOD=/Data/Variable/tmp/btrfs-proto/90goboab
RSYNC_CMP=""
T0=$SECONDS
UPD_FD=/proc/self/fd/8

c_cyan=$'\033[1;36m'; c_red=$'\033[1;31m'; c_off=$'\033[0m'
[ -t 1 ] || { c_cyan=""; c_red=""; c_off=""; }
log()  { mkdir -p "${LOG%/*}"; echo "$(date '+%F %T') [+$((SECONDS - T0)) s] $*" >> "$LOG"; }
say()  { echo "$*"; log "$*"; }
step() { echo "${c_cyan}==> $*${c_off}"; log "==> $*"; }
die()  { echo "${c_red}gobo-update-btrfs-proto: $*${c_off}" >&2; log "ERROR: $*"; exit 1; }

cmdline_arg() { local w; for w in $(cat /proc/cmdline); do case "$w" in "$1="*) echo "${w#*=}"; return 0 ;; esac; done; return 0; }
uuid_of() { case "$1" in UUID=*) echo "${1#UUID=}" ;; *) echo "" ;; esac; }
U() { [ "$1" = a ] && echo A || echo B; }

load_layout() {
   [ "$(cmdline_arg root)" = gobo ] && [ "$(cmdline_arg gobo.layout)" = btrfs ] || die "not started from the btrfs layout (gobo.layout=btrfs)"
   CUR=$(cmdline_arg gobo.slot)
   case "$CUR" in a) OTHER=b ;; b) OTHER=a ;; *) die "unknown running version '$CUR'" ;; esac
   POOL_UUID=$(uuid_of "$(cmdline_arg gobo.root)"); BOOT_UUID=$(uuid_of "$(cmdline_arg gobo.boot)")
   [[ "$POOL_UUID" =~ ^[0-9a-fA-F-]+$ ]] && [[ "$BOOT_UUID" =~ ^[0-9a-fA-F-]+$ ]] || die "gobo.root= / gobo.boot= missing"
   [ "$(cmdline_arg gobo.system-changes)" != off ] || die "started without the system changes: restart normally first"
   CUR_VERSION=$(grub-editenv /System/Slot/gobo-slot.env list 2>/dev/null | sed -n 's/^slot_version=//p' | tr -dc '0-9A-Za-z.-')
}

TMP="" LOOP=""
cleanup() {
   local m
   set +e
   [ -n "$TMP" ] || return 0
   for m in "$TMP/sq" "$TMP/new/System/Kernel/Devices" "$TMP/new/System/Kernel/Objects" "$TMP/new/sys" "$TMP/new/System/Kernel/Status" "$TMP/pool" "$TMP/boot"
   do mountpoint -q "$m" 2>/dev/null && { umount -R "$m" 2>/dev/null || umount -lR "$m"; }
   done
   [ -n "$LOOP" ] && losetup -d "$LOOP" 2>/dev/null
   rm -rf "$TMP"
}
trap cleanup EXIT

mount_all() { # GOBO_BOOT at $TMP/boot, the pool's top level at $TMP/pool
   local bdev pdev
   TMP=$(mktemp -d /tmp/gobo-update-btrfs.XXXXXX)
   mkdir -p "$TMP/boot" "$TMP/pool" "$TMP/sq"
   bdev=$(blkid -U "$BOOT_UUID") && [ -b "$bdev" ] || die "boot partition not found"
   [ "$(blkid -s LABEL -o value "$bdev")" = GOBO_BOOT ] || die "$bdev is not GOBO_BOOT"
   mount -t vfat -o umask=0077 "$bdev" "$TMP/boot" || die "cannot mount $bdev"
   BOOT=$TMP/boot
   grep -qx 'set gobo_layout=btrfs' "$BOOT/grub/grub.cfg" && grep -qx "set gobo_uuid_pool=$POOL_UUID" "$BOOT/grub/grub.cfg" ||
      die "grub.cfg is not the btrfs layout of this pool"
   pdev=$(blkid -U "$POOL_UUID") && [ -b "$pdev" ] || die "pool not found"
   [ "$(blkid -s TYPE -o value "$pdev")" = btrfs ] || die "$pdev is not btrfs"
   mount -t btrfs -o "subvolid=5,$MOUNT_OPTS" "$pdev" "$TMP/pool" || die "cannot mount the pool"
   POOL=$TMP/pool
}

env_get() { grub-editenv "$BOOT/grub/grubenv" list | sed -n "s/^$1=//p" | head -n 1; }
env_write() { # as in gobo-update: copy, edit, rename
   local f="$BOOT/grub/grubenv"
   cp "$f" "$f.new"
   while [ $# -gt 0 ]
   do
      case "$1" in
         set)   shift; while [ $# -gt 0 ] && [ "$1" != -- ]; do grub-editenv "$f.new" set "$1"; shift; done ;;
         unset) shift; while [ $# -gt 0 ] && [ "$1" != -- ]; do grub-editenv "$f.new" unset "$1"; shift; done ;;
         --)    shift ;;
      esac
   done
   sync; mv -f "$f.new" "$f"; sync
   log "grubenv: $(grub-editenv "$f" list | tr '\n' ' ')"
}
# NB: "grub-editenv FILE list" CREATES a missing FILE (an empty block) - and GRUB offers a version as soon
# as gobo/<x>/gobo-slot.env exists. So: never call it on a file that is not there.
boot_version() { [ -f "$BOOT/gobo/$1/gobo-slot.env" ] || return 0; { grub-editenv "$BOOT/gobo/$1/gobo-slot.env" list 2>/dev/null || true; } | sed -n 's/^slot_version=//p' | tr -dc '0-9A-Za-z.-'; }

verify_update() { # the file is fd 8
   local size sum
   [ -f "$UPD_FD" ] || die "not a regular file"
   read -r owner mode U_FILE_SIZE U_FILE_MTIME <<< "$(stat -L -c '%u %a %s %Y' "$UPD_FD")"
   [ "$owner" = 0 ] || [ "$owner" = "${SUDO_UID:-0}" ] || die "the file belongs to another user"
   (( (8#$mode & 8#022) == 0 )) || die "the file is writable by others"
   size=$U_FILE_SIZE
   tail -c $TRAILER_SIZE "$UPD_FD" > "$TMP/trailer"
   [ "$(head -n 1 "$TMP/trailer" | tr -d '\000')" = "GOBOREFINED-UPDATE 1" ] || die "not a GoboRefined update file"
   sed '/^-----BEGIN SIGNATURE-----$/,$d' "$TMP/trailer" > "$TMP/manifest"
   sed -n '/^-----BEGIN SIGNATURE-----$/,/^-----END SIGNATURE-----$/p' "$TMP/trailer" | sed '1d;$d' | openssl base64 -d -A > "$TMP/sig" 2>/dev/null || true
   openssl dgst -sha256 -verify "$PUBKEY" -signature "$TMP/sig" "$TMP/manifest" > /dev/null 2>&1 || die "the signature does not match"
   mf() { sed -n "s/^$1=//p" "$TMP/manifest" | head -n 1; }
   U_VERSION=$(mf version); U_IMAGE_SIZE=$(mf image_size)
   [[ "$U_VERSION" =~ ^[0-9A-Za-z.-]+$ ]] && [[ "$U_IMAGE_SIZE" =~ ^[0-9]+$ ]] || die "bad manifest"
   [ "$size" -eq $((U_IMAGE_SIZE + TRAILER_SIZE)) ] || die "wrong file size"
   step "Checking the file (GoboRefined $U_VERSION)"
   sum=$(head -c "$U_IMAGE_SIZE" "$UPD_FD" | sha256sum | cut -d' ' -f1)
   [ "$sum" = "$(mf image_sha256)" ] || die "checksum mismatch"
   say "    signature and checksum are correct"
}

make_initramfs() { # make_initramfs TREE OUT  (prototype only; see gobo-install-btrfs-proto)
   local R="$1" out="$2" mod KREL
   mod="$R/Programs/GoboSpin/Current/share/gobo-update/dracut/90goboab"
   [ -d "$mod" ] && [ -f "$DRACUT_MOD/goboab-root.sh" ] || die "90goboab not found (tree or --dracut-module)"
   cp "$DRACUT_MOD"/*.sh "$mod/" && chmod 755 "$mod"/*.sh
   KREL=$(ls "$R/Programs/Linux/Current/lib/modules" | head -n 1)
   [[ "$KREL" =~ ^[0-9.]+-Gobo$ ]] || die "kernel release not found"
   mount -t proc proc "$R/System/Kernel/Status"
   mount --rbind /dev "$R/System/Kernel/Devices" && mount --make-rslave "$R/System/Kernel/Devices"
   mount --rbind /sys "$R/System/Kernel/Objects" && mount --make-rslave "$R/System/Kernel/Objects"
   [ "$(readlink "$R/sys")" = System/Kernel/Objects ] || die "unexpected /sys in the new system"
   rm "$R/sys" && mkdir "$R/sys" && mount --rbind /sys "$R/sys" && mount --make-rslave "$R/sys"
   mkdir -p "$R/Data/Variable/tmp"
   chroot "$R" dracut --kver "$KREL" --force --no-hostonly --early-microcode -L 4 --add goboab /Data/Variable/tmp/gobo-proto-initramfs.img >> "$LOG" 2>&1 ||
      die "dracut failed (log $LOG)"
   umount -R "$R/sys" && rmdir "$R/sys" && ln -s System/Kernel/Objects "$R/sys"
   umount -R "$R/System/Kernel/Objects"; umount -R "$R/System/Kernel/Devices"; umount "$R/System/Kernel/Status"
   [ "$(readlink "$R/sys")" = System/Kernel/Objects ] || die "/sys link not restored"
   mv "$R/Data/Variable/tmp/gobo-proto-initramfs.img" "$out"
}

cmd_update() {
   local file new t kpath dry need free
   file=$(readlink -f "$1")
   [ "$(id -u)" = 0 ] || die "run as root"
   load_layout
   mkdir -p "$STATE"; exec 9> "$STATE/lock"; flock -n 9 || die "another update is running"
   [ -f "$file" ] || die "cannot read $file"
   exec 8< "$file"
   mount_all
   verify_update
   new=$POOL/@system-$OTHER
   # never the running version: the running root's subvolume (by btrfs UUID) must not be the target
   cur_id=$(btrfs subvolume show /System/Slot 2>/dev/null | sed -n 's/^[[:space:]]*UUID:[[:space:]]*//p')
   [ -n "$cur_id" ] || die "cannot identify the running subvolume"
   [ "$(btrfs subvolume show "$POOL/@system-$CUR" | sed -n 's/^[[:space:]]*UUID:[[:space:]]*//p')" = "$cur_id" ] ||
      die "@system-$CUR is not the running version"
   if [ -d "$new" ] && [ "$(btrfs subvolume show "$new" | sed -n 's/^[[:space:]]*UUID:[[:space:]]*//p')" = "$cur_id" ]
   then die "@system-$OTHER is the running version"
   fi
   say "Running: $(U "$CUR") (GoboRefined ${CUR_VERSION:-?}). The update goes to $(U "$OTHER") (@system-$OTHER)."

   step "Setting $(U "$OTHER") aside"
   if [ "$(env_get try_slot)" = "$OTHER" ] || [ "$(env_get slot)" = "$OTHER" ]
   then env_write set "slot=$CUR" -- unset try_slot tries_left
   fi
   rm -f "$BOOT/gobo/$OTHER/gobo-slot.env"; sync
   echo "" > "$STATE/slot-$OTHER"
   t=$SECONDS
   if [ -d "$new" ]
   then
      btrfs property set -ts "$new" ro false >> "$LOG" 2>&1 || true
      btrfs subvolume delete "$new" >> "$LOG" 2>&1 || die "cannot delete @system-$OTHER"
   fi
   btrfs subvolume snapshot "$POOL/@system-$CUR" "$new" >> "$LOG" 2>&1 || die "snapshot failed"
   rm -f "$new/gobo-slot.env"; sync
   log "delete + snapshot $((SECONDS - t)) s"

   step "Copying GoboRefined $U_VERSION over the snapshot"
   LOOP=$(losetup -r -f --show --sizelimit "$U_IMAGE_SIZE" "$UPD_FD") || die "losetup failed"
   mount -t squashfs -o ro "$LOOP" "$TMP/sq" || die "cannot mount the update's image"
   t=$SECONDS
   dry=$(rsync -aHAX --numeric-ids --delete $RSYNC_CMP --dry-run --stats "$TMP/sq/" "$new/" | sed -n 's/^Total transferred file size: \([0-9,]*\) bytes.*/\1/p' | tr -d ,)
   [[ "$dry" =~ ^[0-9]+$ ]] || die "rsync dry run gave no size"
   free=$(btrfs filesystem usage -b "$POOL" | sed -n 's/^[[:space:]]*Free (estimated):[[:space:]]*\([0-9]*\).*/\1/p' | head -n 1)
   need=$((dry + MARGIN))
   log "dry run $((SECONDS - t)) s: $dry bytes to write; free (estimated) $free"
   [[ "$free" =~ ^[0-9]+$ ]] && [ "$free" -ge "$need" ] ||
      die "not enough free space: the update writes up to $((dry / 1048576)) MB (+2 GiB margin), the pool has $(( ${free:-0} / 1048576)) MB free; nothing was changed in $(U "$CUR")"
   t=$SECONDS
   rsync -aHAX --numeric-ids --delete $RSYNC_CMP --stats "$TMP/sq/" "$new/" > "$TMP/rsync.out" 2>> "$LOG" || die "rsync failed"
   grep -E '^(Number of (regular )?files|Number of .*transferred|Number of deleted|Total file size|Total transferred)' "$TMP/rsync.out" | tee -a "$LOG" | sed 's/^/    /'
   log "rsync $((SECONDS - t)) s"
   umount "$TMP/sq"; losetup -d "$LOOP"; LOOP=""
   [ "$(stat -L -c '%s %Y' "$UPD_FD")" = "$U_FILE_SIZE $U_FILE_MTIME" ] || die "the update file changed while it was copied"
   exec 8<&-

   step "Checking the new system"
   for p in System/Kernel/Boot/kernel System/Kernel/Boot/initramfs System/Index/bin/gobo-update Programs/Scripts
   do [ -e "$new/$p" ] || [ -L "$new/$p" ] || die "the new system has no $p"
   done
   [ "$(head -n 1 "$new/Programs/GoboSpin/Current/share/spin-version" | tr -dc '0-9A-Za-z.-')" = "$U_VERSION" ] || die "version mismatch"

   step "Initramfs with the btrfs path (prototype only)"
   t=$SECONDS
   mkdir -p "$BOOT/gobo/$OTHER"
   make_initramfs "$new" "$BOOT/gobo/$OTHER/initramfs.new"
   log "initramfs $((SECONDS - t)) s"
   kpath=$(chroot "$new" readlink -f /System/Kernel/Boot/kernel)
   case "$kpath" in /Programs/Linux/*|/System/Kernel/Boot/kernel-*) ;; *) die "kernel link points to '$kpath'" ;; esac
   cp "$new$kpath" "$BOOT/gobo/$OTHER/kernel.new"
   sync
   mv -f "$BOOT/gobo/$OTHER/kernel.new" "$BOOT/gobo/$OTHER/kernel"
   mv -f "$BOOT/gobo/$OTHER/initramfs.new" "$BOOT/gobo/$OTHER/initramfs"
   grub-editenv "$new/gobo-slot.env" create
   grub-editenv "$new/gobo-slot.env" set "slot_version=$U_VERSION"
   sync
   btrfs property set -ts "$new" ro true >> "$LOG" 2>&1 || die "cannot make @system-$OTHER read-only"
   # written last: GRUB offers the new version from here on
   grub-editenv "$BOOT/gobo/$OTHER/gobo-slot.env.new" create
   grub-editenv "$BOOT/gobo/$OTHER/gobo-slot.env.new" set "slot_version=$U_VERSION"
   sync
   mv -f "$BOOT/gobo/$OTHER/gobo-slot.env.new" "$BOOT/gobo/$OTHER/gobo-slot.env"
   sync
   echo "$U_VERSION" > "$STATE/slot-$OTHER"
   env_write set "try_slot=$OTHER" "tries_left=2"
   step "Done in $((SECONDS - T0)) s"
   btrfs filesystem du -s "$POOL/@system-a" "$POOL/@system-b" 2>/dev/null | tee -a "$LOG"
   say "GoboRefined $U_VERSION is ready as $(U "$OTHER"); it starts at the next restart (back to ${CUR_VERSION:-the current version} by itself if it does not start)."
}

cmd_status() {
   local s v def
   load_layout; mount_all
   def=$(env_get slot); [ "$def" = b ] || def=a
   for s in a b
   do
      v=$(boot_version $s)
      printf '  %s  %-12s' "$(U $s)" "${v:-empty}"
      if [ "$s" = "$CUR" ]; then printf ' [running]'; fi
      if [ "$s" = "$def" ]; then printf ' [default]'; fi
      if [ "$s" = "$(env_get try_slot)" ]; then printf ' [new: %s tries left]' "$(env_get tries_left)"; fi
      echo
   done
   if [ -n "$(env_get rollback_from)" ]; then echo "  rollback from $(env_get rollback_from)"; fi
   btrfs filesystem du -s "$POOL"/@system-* "$POOL/@data" "$POOL/@swap"
   btrfs filesystem usage -b "$POOL" | sed -n 's/^[[:space:]]*\(Device size\|Used\|Free (estimated)\):/  &/p'
}

cmd_remake_initramfs() { # prototype helper: a new initramfs for the RUNNING version (from a snapshot of it)
   local tmpvol
   [ "$(id -u)" = 0 ] || die "run as root"
   load_layout; mount_all
   tmpvol=$POOL/@initramfs-work
   [ ! -e "$tmpvol" ] || btrfs subvolume delete "$tmpvol" >> "$LOG" 2>&1
   btrfs subvolume snapshot "$POOL/@system-$CUR" "$tmpvol" >> "$LOG" 2>&1 || die "snapshot failed"
   make_initramfs "$tmpvol" "$BOOT/gobo/$CUR/initramfs.new"
   btrfs subvolume delete "$tmpvol" >> "$LOG" 2>&1
   sync; mv -f "$BOOT/gobo/$CUR/initramfs.new" "$BOOT/gobo/$CUR/initramfs"; sync
   say "new initramfs for $(U "$CUR") written"
}

cmd_rollback() {
   local v
   [ "$(id -u)" = 0 ] || die "run as root"
   load_layout; mount_all
   v=$(boot_version "$OTHER")
   [ -n "$v" ] || die "$(U "$OTHER") is empty or incomplete"
   env_write set "slot=$OTHER" -- unset try_slot tries_left
   say "From the next restart on, $(U "$OTHER") (GoboRefined $v) starts."
}

file=""
while [ $# -gt 0 ]
do
   case "$1" in
      --status) cmd_status; exit 0 ;;
      --rollback) cmd_rollback; exit 0 ;;
      --remake-initramfs) cmd_remake_initramfs; exit 0 ;;
      --dracut-module) DRACUT_MOD="$2"; shift ;;
      --checksum) RSYNC_CMP=--checksum ;;
      -h|--help) sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
      -*) die "unknown option $1" ;;
      *) file="$1" ;;
   esac
   shift
done
[ -n "$file" ] || die "give an update file (or --status / --rollback)"
cmd_update "$file"
