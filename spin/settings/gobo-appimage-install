#!/bin/sh
# gobo-appimage-install — the AppImage installer of 0.10.6/0.10.7, since 0.10.8 a name for gobo-install-app
# (the one installer for AppImages, GoboLinux packages and program archives). Kept because .xinitrc
# files of 0.10.7 call "gobo-appimage-install --fix-icons" and older file manager actions call it.
exec /System/Index/bin/gobo-install-app "$@"
