#!/bin/sh
# gobo-appimage-install — GoboRefined 0.10.6: "Install" for AppImages (file manager action
# ~/.local/share/file-manager/actions/gobo-appimage-install.desktop), as the user, no password:
#   gobo-appimage-install FILE.AppImage     move it to ~/Applications/<Name>/, then one dialog:
#                                           start menu entry, pin, both or no shortcut
#   gobo-appimage-install --offer FILE      prints "true" when the action should be offered
#                                           (an AppImage that is not in ~/Applications yet)
# The work is done by appimage-install.lua (Lua + lgi + GTK 3) next to the Settings app's files.
export NO_AT_BRIDGE=1
if [ "${1:-}" = "--offer" ]
then
   case " $(id -Gn 2>/dev/null) " in
      *" simple "*) echo false; exit 0 ;;   # Simple accounts: no installing
   esac
   case "${2:-}" in
      "$HOME/Applications/"*) echo false ;;
      *.[Aa]pp[Ii]mage) echo true ;;
      *) echo false ;;
   esac
   exit 0
fi
[ $# -eq 1 ] || { echo "usage: gobo-appimage-install FILE.AppImage" >&2; exit 2; }
exec lua /Programs/GoboSpin/Current/share/gobo-settings/appimage-install.lua "$1"
