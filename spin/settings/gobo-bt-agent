#!/bin/sh
# gobo-bt-agent — the Bluetooth pairing agent of the desktop session (GoboRefined 0.8.4).
# Started by ~/.xinitrc; asks on screen when a Bluetooth device wants to pair (see
# /Programs/GoboSpin/Current/share/gobo-settings/bt-agent.lua). One per user: a second start
# exits at once. Harmless without a Bluetooth adapter (it waits for the Bluetooth service).
export NO_AT_BRIDGE=1   # no accessibility bus here: GTK would warn and wait
[ -n "${DISPLAY:-}" ] || { echo "gobo-bt-agent: no desktop (DISPLAY is not set)" >&2; exit 1; }
[ -n "${HOME:-}" ] && [ -d "$HOME" ] || exit 1
mkdir -p "$HOME/.cache" || exit 1
exec flock -n "$HOME/.cache/gobo-bt-agent.lock" lua /Programs/GoboSpin/Current/share/gobo-settings/bt-agent.lua
