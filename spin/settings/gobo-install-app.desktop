[Desktop Entry]
Type=Application
Name=Install or extract
Comment=Install a program file (AppImage, GoboLinux package, program archive), run it once, or extract an archive
Icon=system-software-install
Exec=gobo-install-app --ask %f
Terminal=false
NoDisplay=true
MimeType=application/vnd.appimage;application/x-iso9660-appimage;application/zip;application/x-zip-compressed;application/x-compressed-tar;application/x-bzip-compressed-tar;application/x-bzip2-compressed-tar;application/x-xz-compressed-tar;application/x-zstd-compressed-tar;application/x-lzma-compressed-tar;application/x-tar;application/x-7z-compressed;application/vnd.rar;application/x-rar;application/x-rar-compressed;
