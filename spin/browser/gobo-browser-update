#!/bin/bash
# gobo-browser-update — GoboRefined Firefox ESR updater (P3, Browser lane).
#
# Updates Firefox ESR in the persistent overlay (/Programs/Firefox/<ver>) without
# needing a full OS image rebuild. Verifies Mozilla's OpenPGP signature against
# the pinned primary key and checks SHA-512 before unpacking. Keeps the previous
# version for 1-click undo and automatically rolls back if the new Firefox fails
# a headless startup health check.
#
# Usage:
#   gobo-browser-update status                 (any user; prints key=value lines)
#   gobo-browser-update check                  (any user; queries Mozilla ESR JSON)
#   gobo-browser-update update [--version V] [--force] [--base-url URL]  (root)
#   gobo-browser-update undo                   (root)
#   gobo-browser-update auto on|off            (root)
#   gobo-browser-update reconcile              (root; boot hook — newest valid ESR wins)
#   gobo-browser-update auto-run               (root; daily background check+update)
set -euo pipefail

export PATH="/System/Index/bin:/System/Index/sbin:/usr/bin:/bin:/usr/sbin:/sbin"

MOZILLA_PRIMARY_FP="14F26682D0916CDD81E37B6D61B7B526D98F0353"
MOZILLA_VERSIONS_URL="https://product-details.mozilla.org/1.0/firefox_versions.json"
MOZILLA_RELEASE_BASE="https://archive.mozilla.org/pub/firefox/releases"

KEY_FILE="/Programs/GoboSpin/Current/share/gobo-browser-update/mozilla-release-key.asc"
PGP_VERIFY="/System/Index/bin/gobo-pgp-verify"
[ -f "$PGP_VERIFY" ] || PGP_VERIFY="/Programs/GoboSpin/Current/bin/gobo-pgp-verify"

STATE_DIR="/Data/Variable/lib/gobo-browser-update"
AUTO_FILE="$STATE_DIR/auto"
LAST_CHECK_FILE="$STATE_DIR/last-check"
PREV_FILE="$STATE_DIR/prev-version"
LAST_ERR_FILE="$STATE_DIR/last-error"
LOCK_FILE="/Data/Variable/run/gobo-browser-update.lock"
LOG_FILE="/Data/Variable/log/gobo-browser-update.log"

die() { echo "gobo-browser-update: ERROR: $*" >&2; exit 1; }
log() {
   local ts
   ts="$(date '+%Y-%m-%d %H:%M:%S')"
   mkdir -p "$(dirname "$LOG_FILE")" 2>/dev/null || true
   printf '%s %s\n' "$ts" "$*" >> "$LOG_FILE" 2>/dev/null || true
}
need_root() { [ "$(id -u)" = "0" ] || die "must run as root"; }
valid_ver() { [[ "${1:-}" =~ ^[0-9]{2,3}\.[0-9]{1,3}(\.[0-9]{1,3})?esr$ ]]; }

ver_gt() {
   # Return 0 if version $1 > $2 (strip trailing esr, compare with sort -V)
   local a="${1%esr}" b="${2%esr}"
   [ "$a" != "$b" ] && [ "$(printf '%s\n%s\n' "$a" "$b" | sort -V | tail -n 1)" = "$a" ]
}

current_ver() {
   readlink /Programs/Firefox/Current 2>/dev/null || echo "unknown"
}

slot_ver() {
   readlink /System/Slot/Programs/Firefox/Current 2>/dev/null || echo ""
}

auto_setting() {
   if [ -f "$AUTO_FILE" ]; then
      local v
      v=$(head -n 1 "$AUTO_FILE" 2>/dev/null | tr -d '[:space:]')
      [ "$v" = "off" ] && { echo "off"; return; }
   fi
   echo "on"
}

prev_ver_valid() {
   [ -f "$PREV_FILE" ] || return 1
   local pv cur
   pv=$(head -n 1 "$PREV_FILE" 2>/dev/null | tr -d '[:space:]')
   cur=$(current_ver)
   valid_ver "$pv" || return 1
   [ "$pv" != "$cur" ] || return 1
   [ -x "/Programs/Firefox/$pv/package/firefox" ] || return 1
   echo "$pv"
}

fetch_latest_esr() {
   local url="$1" json ver
   json=$(curl -fsSL --max-time 20 "$url" 2>/dev/null) || return 1
   ver=$(printf '%s' "$json" | python3 -I -c 'import json,sys; d=json.load(sys.stdin); print(d.get("FIREFOX_ESR",""))' 2>/dev/null) || return 1
   valid_ver "$ver" || return 1
   printf '%s\n' "$ver"
}

record_check() {
   local status="$1" latest="${2:-}"
   [ "$(id -u)" = "0" ] || return 0
   mkdir -p "$STATE_DIR"
   chmod 755 "$STATE_DIR"
   local tmp
   tmp=$(mktemp "$STATE_DIR/.check.XXXXXX")
   printf 'time=%s\nepoch=%s\nstatus=%s\nlatest=%s\n' \
      "$(date '+%Y-%m-%d %H:%M')" "$(date +%s)" "$status" "$latest" > "$tmp"
   chmod 644 "$tmp"
   mv -f "$tmp" "$LAST_CHECK_FILE"
}

record_error() {
   [ "$(id -u)" = "0" ] || return 0
   mkdir -p "$STATE_DIR"
   printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M')" "$*" > "$LAST_ERR_FILE"
   chmod 644 "$LAST_ERR_FILE"
}

clear_error() {
   rm -f "$LAST_ERR_FILE" 2>/dev/null || true
}

activate_firefox() {
   local ver="$1"
   valid_ver "$ver" || die "refusing to activate invalid version '$ver'"
   [ -x "/Programs/Firefox/$ver/package/firefox" ] || die "Firefox $ver is not installed"
   ln -sfn "$ver" /Programs/Firefox/Current
   HOME=/Users/root SymlinkProgram --terse Firefox "$ver" > /dev/null 2>&1 ||
      HOME=/Users/root SymlinkProgram Firefox "$ver" > /dev/null 2>&1
}

write_firefox_launcher() {
   local dst="$1"
   cat > "$dst" <<'LAUNCHER'
#!/bin/bash
# GoboRefined launcher for Firefox ESR (preserves ~/.mozilla/firefox/goborefined-esr).
pkgdir=$(readlink -f "$(dirname "$(which firefox)")/../package")
for a in "$@"
do case "$a" in
      -P|--P|-profile|--profile|-ProfileManager|--ProfileManager|-v|--version|-h|--help|--headless)
         exec "$pkgdir/firefox" "$@" ;;
   esac
done
[ -n "${HOME:-}" ] || exec "$pkgdir/firefox" "$@"
base="$HOME/.mozilla/firefox"
prof="$base/goborefined-esr"
if [ ! -d "$prof" ]
then
   mkdir -p "$base"
   old=
   if [ -f "$base/profiles.ini" ]
   then
      rel=$(awk -F= '/^\[/ { if (d && p != "") { print p; exit } p = ""; d = 0 }
                     $1 == "Path" { p = $2 } $1 == "Default" && $2 == "1" { d = 1 }
                     END { if (d && p != "") print p }' "$base/profiles.ini" | head -n 1)
      case "$rel" in
         "") ;;
         /*) old="$rel" ;;
         *)  old="$base/$rel" ;;
      esac
   fi
   [ -n "$old" ] && [ -f "$old/places.sqlite" ] || old=
   tmp="$prof.new.$$"
   rm -rf "$tmp"
   if [ -n "$old" ] && cp -a "$old" "$tmp" 2>/dev/null
   then rm -f "$tmp/lock" "$tmp/.parentlock"
   else rm -rf "$tmp"; mkdir -p "$tmp"
   fi
   chmod 700 "$tmp"
   mv "$tmp" "$prof" 2>/dev/null || rm -rf "$tmp"
fi
[ -d "$prof" ] || exec "$pkgdir/firefox" "$@"
exec "$pkgdir/firefox" --profile "$prof" "$@"
LAUNCHER
   chmod 755 "$dst"
}

health_check_firefox() {
   local ver="$1"
   local bin="/Programs/Firefox/$ver/package/firefox"
   [ -x "$bin" ] || return 1
   local hc_dir
   hc_dir=$(mktemp -d /Data/Variable/tmp/gobo-ff-hc.XXXXXX) || return 1
   mkdir -p "$hc_dir/prof" "$hc_dir/run"
   chmod 700 "$hc_dir/run"
   local rc=0
   # Step 1: binary runs and reports version
   if ! HOME="$hc_dir" timeout 15 "$bin" --version >/dev/null 2>&1; then
      rc=1
   fi
   # Step 2: real headless startup + screenshot of about:blank
   if [ "$rc" = "0" ]; then
      local shot="$hc_dir/hc.png"
      HOME="$hc_dir" XDG_RUNTIME_DIR="$hc_dir/run" MOZ_HEADLESS=1 \
         timeout 40 "$bin" --headless --no-remote --profile "$hc_dir/prof" --screenshot "$shot" about:blank >"$hc_dir/hc.log" 2>&1 || rc=1
      [ -s "$shot" ] || rc=1
      if [ "$rc" != "0" ] && [ -s "$hc_dir/hc.log" ]; then
         tail -n 10 "$hc_dir/hc.log" >&2
      fi
   fi
   rm -rf --one-file-system -- "$hc_dir"
   return "$rc"
}

prune_old_versions() {
   local cur prev slot d base
   cur=$(current_ver)
   prev=$(prev_ver_valid 2>/dev/null || true)
   slot=$(slot_ver)
   for d in /Programs/Firefox/*esr; do
      [ -d "$d" ] && [ ! -L "$d" ] || continue
      base=$(basename "$d")
      valid_ver "$base" || continue
      [ "$base" = "$cur" ] && continue
      [ "$base" = "$prev" ] && continue
      [ "$base" = "$slot" ] && continue
      # Only prune versions that do NOT exist in the read-only system slot
      [ -d "/System/Slot/Programs/Firefox/$base" ] && continue
      log "pruning superseded overlay Firefox $base"
      rm -rf --one-file-system -- "$d"
   done
}

cmd_status() {
   local cur sv pv au last_t="" last_s="" last_l="" last_e=""
   cur=$(current_ver)
   sv=$(slot_ver)
   pv=$(prev_ver_valid 2>/dev/null || true)
   au=$(auto_setting)
   if [ -f "$LAST_CHECK_FILE" ]; then
      last_t=$(sed -n 's/^time=//p' "$LAST_CHECK_FILE" | head -n 1)
      last_s=$(sed -n 's/^status=//p' "$LAST_CHECK_FILE" | head -n 1)
      last_l=$(sed -n 's/^latest=//p' "$LAST_CHECK_FILE" | head -n 1)
   fi
   [ -f "$LAST_ERR_FILE" ] && last_e=$(head -n 1 "$LAST_ERR_FILE")
   printf 'installed=%s\n' "$cur"
   printf 'slot=%s\n' "$sv"
   printf 'auto=%s\n' "$au"
   printf 'undo=%s\n' "$pv"
   printf 'last_check=%s\n' "$last_t"
   printf 'last_status=%s\n' "$last_s"
   printf 'latest=%s\n' "$last_l"
   printf 'last_error=%s\n' "$last_e"
}

cmd_check() {
   local cur latest
   cur=$(current_ver)
   if ! latest=$(fetch_latest_esr "$MOZILLA_VERSIONS_URL"); then
      record_check "error" ""
      echo "CHECK-FAILED could not reach Mozilla"
      return 1
   fi
   if valid_ver "$cur" && ! ver_gt "$latest" "$cur"; then
      record_check "up-to-date" "$latest"
      echo "UP-TO-DATE $cur"
   else
      record_check "update-available" "$latest"
      echo "UPDATE-AVAILABLE $cur -> $latest"
   fi
}

cmd_update() {
   need_root
   local target_ver="" force=0 base_url="$MOZILLA_RELEASE_BASE" versions_url="$MOZILLA_VERSIONS_URL"
   while [ $# -gt 0 ]; do
      case "$1" in
         --version)  target_ver="$2"; shift 2 ;;
         --force)    force=1; shift ;;
         --base-url) base_url="$2"; shift 2 ;;
         --versions-url) versions_url="$2"; shift 2 ;;
         *) die "update: unknown option '$1'" ;;
      esac
   done

   mkdir -p "$(dirname "$LOCK_FILE")" "$STATE_DIR"
   exec 9> "$LOCK_FILE"
   flock -n 9 || die "another browser update is already running"

   [ -f "$KEY_FILE" ] || die "pinned Mozilla public key missing: $KEY_FILE"
   [ -f "$PGP_VERIFY" ] || die "OpenPGP verifier missing: $PGP_VERIFY"

   local cur
   cur=$(current_ver)
   if [ -z "$target_ver" ]; then
      echo "Checking Mozilla for the latest Firefox ESR..."
      target_ver=$(fetch_latest_esr "$versions_url") || {
         record_check "error" ""
         die "could not check Mozilla for the latest Firefox ESR (no internet?)"
      }
   fi
   valid_ver "$target_ver" || die "invalid Firefox ESR version: $target_ver"

   if [ "$force" = "0" ] && valid_ver "$cur" && ! ver_gt "$target_ver" "$cur"; then
      record_check "up-to-date" "$target_ver"
      clear_error
      echo "Firefox $cur is already up to date (latest ESR: $target_ver)."
      return 0
   fi

   # Check free disk space (>= 600 MiB on /Programs)
   local avail_kb
   avail_kb=$(df -Pk /Programs | awk 'NR==2 { print $4 }')
   [ "${avail_kb:-0}" -ge 614400 ] || die "not enough free disk space on /Programs (need at least 600 MB)"

   local tmp work_prog=""
   tmp=$(mktemp -d /Data/Variable/tmp/gobo-ff.XXXXXX) || die "could not create temporary folder"
   chmod 700 "$tmp"
   cleanup_upd() {
      rm -rf --one-file-system -- "$tmp"
      [ -n "$work_prog" ] && [ -d "$work_prog" ] && rm -rf --one-file-system -- "$work_prog"
   }
   trap cleanup_upd EXIT

   local rel_url="${base_url%/}/$target_ver"
   local tar_rel="linux-x86_64/en-US/firefox-$target_ver.tar.xz"
   echo "Downloading Firefox $target_ver and Mozilla signatures..."
   log "update started: $cur -> $target_ver (from $rel_url)"
   curl -fsSL --max-time 30 -o "$tmp/SHA512SUMS" "$rel_url/SHA512SUMS" || die "failed to download SHA512SUMS"
   curl -fsSL --max-time 30 -o "$tmp/SHA512SUMS.asc" "$rel_url/SHA512SUMS.asc" || die "failed to download SHA512SUMS.asc"
   curl -fsSL --max-time 30 -o "$tmp/KEY" "$rel_url/KEY" 2>/dev/null || rm -f "$tmp/KEY"

   echo "Verifying Mozilla OpenPGP signature..."
   local extra_arg=()
   [ -s "$tmp/KEY" ] && extra_arg=(--extra-key "$tmp/KEY")
   local vout
   if ! vout=$(python3 -I "$PGP_VERIFY" --primary-fp "$MOZILLA_PRIMARY_FP" --key "$KEY_FILE" "${extra_arg[@]}" --sig "$tmp/SHA512SUMS.asc" --file "$tmp/SHA512SUMS" 2>&1); then
      record_error "OpenPGP signature verification failed for $target_ver"
      log "FAILED OpenPGP verification for $target_ver: $vout"
      die "Mozilla OpenPGP signature verification FAILED: $vout"
   fi
   echo "$vout"
   log "$vout"

   local expected_sha512
   expected_sha512=$(awk -v f="$tar_rel" '$2 == f { print $1; exit }' "$tmp/SHA512SUMS")
   [[ "$expected_sha512" =~ ^[0-9a-fA-F]{128}$ ]] || die "could not find $tar_rel in verified SHA512SUMS"

   echo "Downloading firefox-$target_ver.tar.xz..."
   curl -fsSL --max-time 600 -o "$tmp/firefox.tar.xz" "$rel_url/$tar_rel" || die "failed to download firefox-$target_ver.tar.xz"

   echo "Verifying SHA-512 checksum..."
   local actual_sha512
   actual_sha512=$(sha512sum "$tmp/firefox.tar.xz" | awk '{ print $1 }')
   if [ "${actual_sha512,,}" != "${expected_sha512,,}" ]; then
      record_error "SHA-512 mismatch for $target_ver"
      log "FAILED SHA-512 mismatch for $target_ver"
      die "SHA-512 checksum mismatch for firefox-$target_ver.tar.xz"
   fi

   echo "Installing Firefox $target_ver into /Programs/Firefox/$target_ver..."
   mkdir -p /Programs/Firefox
   work_prog=$(mktemp -d "/Programs/Firefox/.install-XXXXXX") || die "cannot create install directory"
   chmod 755 "$work_prog"
   mkdir -p "$work_prog/bin" "$work_prog/Resources" "$work_prog/share/applications" "$work_prog/share/icons"
   tar xf "$tmp/firefox.tar.xz" -C "$work_prog" || die "failed to unpack firefox-$target_ver.tar.xz"
   mv "$work_prog/firefox" "$work_prog/package" || die "unexpected Firefox tarball layout"
   [ -x "$work_prog/package/firefox" ] && [ -f "$work_prog/package/libxul.so" ] || die "incomplete Firefox binary tree"

   mkdir -p "$work_prog/package/distribution"
   printf '%s\n' '{' '  "policies": {' '    "DisableAppUpdate": true' '  }' '}' > "$work_prog/package/distribution/policies.json"
   write_firefox_launcher "$work_prog/bin/firefox"

   # Reuse desktop entry and icons from the active Firefox installation
   local ref="/Programs/Firefox/$cur"
   [ -d "$ref/share/applications" ] && cp -a "$ref/share/applications/." "$work_prog/share/applications/" 2>/dev/null || true
   [ -d "$ref/share/icons" ] && cp -a "$ref/share/icons/." "$work_prog/share/icons/" 2>/dev/null || true
   printf '[Name] Firefox\n[Summary] Mozilla Firefox ESR %s (updated by gobo-browser-update)\n[License] MPL-2.0\n[Homepage] https://www.mozilla.org/firefox/\n' "$target_ver" > "$work_prog/Resources/Description"

   chown -R root:root "$work_prog"
   chmod -R go-w "$work_prog"

   local target_dir="/Programs/Firefox/$target_ver"
   if [ -d "$target_dir" ] && [ "$force" = "1" ] && [ ! -d "/System/Slot/Programs/Firefox/$target_ver" ]; then
      rm -rf --one-file-system -- "$target_dir"
   fi
   [ ! -e "$target_dir" ] || die "/Programs/Firefox/$target_ver already exists"
   mv -T -- "$work_prog" "$target_dir"
   work_prog=""

   # Activate and run headless health check; automatically roll back on failure
   echo "Activating Firefox $target_ver and running startup health check..."
   activate_firefox "$target_ver"
   if ! health_check_firefox "$target_ver"; then
      echo "Health check FAILED — rolling back automatically to Firefox $cur..." >&2
      log "health check FAILED for $target_ver — rolling back to $cur"
      record_error "Firefox $target_ver failed startup health check; rolled back to $cur"
      if valid_ver "$cur" && [ -x "/Programs/Firefox/$cur/package/firefox" ]; then
         activate_firefox "$cur"
      fi
      rm -rf --one-file-system -- "$target_dir"
      die "Firefox $target_ver failed startup check and was rolled back to $cur"
   fi

   if valid_ver "$cur" && [ "$cur" != "$target_ver" ]; then
      printf '%s\n' "$cur" > "$PREV_FILE"
      chmod 644 "$PREV_FILE"
   fi
   record_check "up-to-date" "$target_ver"
   clear_error
   prune_old_versions
   log "UPDATED-OK $cur -> $target_ver"
   echo "UPDATED-OK $cur -> $target_ver"
}

cmd_undo() {
   need_root
   mkdir -p "$(dirname "$LOCK_FILE")" "$STATE_DIR"
   exec 9> "$LOCK_FILE"
   flock -n 9 || die "another browser update is already running"

   local cur pv
   cur=$(current_ver)
   pv=$(prev_ver_valid) || die "no previous Firefox version available to undo to"
   echo "Switching Firefox back from $cur to $pv..."
   activate_firefox "$pv"
   printf '%s\n' "$cur" > "$PREV_FILE"
   chmod 644 "$PREV_FILE"
   clear_error
   log "UNDONE $cur -> $pv"
   echo "UNDONE $cur -> $pv"
}

cmd_auto() {
   need_root
   [ $# -eq 1 ] || die "auto requires 'on' or 'off'"
   case "$1" in
      on|off)
         mkdir -p "$STATE_DIR"
         chmod 755 "$STATE_DIR"
         printf '%s\n' "$1" > "$AUTO_FILE"
         chmod 644 "$AUTO_FILE"
         log "auto-update set to $1"
         echo "auto=$1" ;;
      *) die "say on or off" ;;
   esac
}

cmd_reconcile() {
   need_root
   # After a system A/B update, if the new system slot carries a newer Firefox ESR than Current,
   # switch Current to the newest valid ESR across both the slot and the persistent overlay.
   local cur best d base
   cur=$(current_ver)
   best="$cur"
   for d in /Programs/Firefox/*esr; do
      [ -d "$d" ] && [ ! -L "$d" ] || continue
      base=$(basename "$d")
      valid_ver "$base" || continue
      [ -x "$d/package/firefox" ] || continue
      if ! valid_ver "$best" || ver_gt "$base" "$best"; then
         best="$base"
      fi
   done
   if valid_ver "$best" && [ "$best" != "$cur" ]; then
      log "reconcile: promoting Firefox $cur -> $best"
      activate_firefox "$best"
      echo "RECONCILED $cur -> $best"
   fi
}

cmd_auto_run() {
   need_root
   [ "$(auto_setting)" = "on" ] || return 0
   # At most once every 20 hours
   if [ -f "$LAST_CHECK_FILE" ]; then
      local last_ep now_ep
      last_ep=$(sed -n 's/^epoch=//p' "$LAST_CHECK_FILE" | head -n 1)
      now_ep=$(date +%s)
      if [[ "$last_ep" =~ ^[0-9]+$ ]] && [ $((now_ep - last_ep)) -lt 72000 ]; then
         return 0
      fi
   fi
   cmd_update >/dev/null 2>&1 || true
}

[ $# -ge 1 ] || die "usage: gobo-browser-update status|check|update|undo|auto|reconcile|auto-run"
CMD="$1"; shift
case "$CMD" in
   status)    cmd_status "$@" ;;
   check)     cmd_check "$@" ;;
   update)    cmd_update "$@" ;;
   undo)      cmd_undo "$@" ;;
   auto)      cmd_auto "$@" ;;
   reconcile) cmd_reconcile "$@" ;;
   auto-run)  cmd_auto_run "$@" ;;
   *)         die "unknown command: $CMD" ;;
esac
