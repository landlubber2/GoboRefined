+/* GoboRefined: list the sticks mounted under GOBO_USB_DIR right below "USB drives".
+ * A stick is a sub-folder that is a mount point (other device than GOBO_USB_DIR). */
+static void refresh_usb_sticks(FmPlacesModel* model)
+{
+    GtkListStore* store = GTK_LIST_STORE(model);
+    GtkTreeIter it;
+    FmPlacesItem* item;
+    GDir* dir;
+    const char* name;
+    struct stat top_st, st;
+    gboolean more;
+
+    /* drop the old stick entries */
+    more = gtk_tree_model_get_iter_first(GTK_TREE_MODEL(model), &it);
+    while (more)
+    {
+        item = NULL;
+        gtk_tree_model_get(GTK_TREE_MODEL(model), &it, FM_PLACES_MODEL_COL_INFO, &item, -1);
+        if (item && item->type == FM_PLACES_ITEM_PATH && item->id == FM_PLACES_ID_USB_STICK)
+        {
+            more = gtk_list_store_remove(store, &it);
+            place_item_free(item);
+        }
+        else
+            more = gtk_tree_model_iter_next(GTK_TREE_MODEL(model), &it);
+    }
+    if (stat(GOBO_USB_DIR, &top_st) != 0)
+        return;
+    dir = g_dir_open(GOBO_USB_DIR, 0, NULL);
+    if (!dir)
+        return;
+    while ((name = g_dir_read_name(dir)) != NULL)
+    {
+        char* full = g_build_filename(GOBO_USB_DIR, name, NULL);
+        /* lstat: links (such as an old /Mount/Media/Media) are not sticks */
+        if (lstat(full, &st) == 0 && S_ISDIR(st.st_mode) && st.st_dev != top_st.st_dev)
+        {
+            FmPath* path = fm_path_new_for_str(full);
+            char* label = g_filename_display_name(name);
+            new_path_item(store, &it, path, FM_PLACES_ID_USB_STICK, label,
+                          "drive-removable-media", NULL);
+            g_free(label);
+            fm_path_unref(path);
+        }
+        g_free(full);
+    }
+    g_dir_close(dir);
+}
+
+static gboolean on_usb_refresh_timeout(gpointer user_data)
+{
+    FmPlacesModel* model = FM_PLACES_MODEL(user_data);
+    refresh_usb_sticks(model);
+    /* devmon creates the folder first and mounts a moment later: look again */
+    if (++model->usb_refresh_count < 3)
+        return TRUE;
+    model->usb_refresh_handler = 0;
+    return FALSE;
+}
+
+static void on_usb_dir_changed(GFileMonitor* mon, GFile* gf, GFile* other,
+                               GFileMonitorEvent evt, FmPlacesModel* model)
+{
+    model->usb_refresh_count = 0;
+    if (model->usb_refresh_handler == 0)
+        model->usb_refresh_handler = gdk_threads_add_timeout_seconds(1, on_usb_refresh_timeout, model);
+}
+
+static void create_usb_items(FmPlacesModel* model, FmFileInfoJob* job)
+{
+    GtkTreeIter it;
+    FmPath* path;
+    GFile* gf;
+
+    if (!g_file_test(GOBO_USB_DIR, G_FILE_TEST_IS_DIR))
+        return;
+    path = fm_path_new_for_str(GOBO_USB_DIR);
+    new_path_item(GTK_LIST_STORE(model), &it, path, FM_PLACES_ID_USB,
+                  _("USB drives"), "usb", job); /* Papirus: blue USB symbol */
+    fm_path_unref(path);
+    gf = g_file_new_for_path(GOBO_USB_DIR);
+    model->usb_monitor = g_file_monitor_directory(gf, G_FILE_MONITOR_NONE, NULL, NULL);
+    g_object_unref(gf);
+    if (model->usb_monitor)
+        g_signal_connect(model->usb_monitor, "changed", G_CALLBACK(on_usb_dir_changed), model);
+    /* sticks already mounted: list them once the model is complete */
+    model->usb_refresh_count = 2;
+    model->usb_refresh_handler = gdk_threads_add_idle(on_usb_refresh_timeout, model);
+}
