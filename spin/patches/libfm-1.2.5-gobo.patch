  *
  * Returns: TRUE if no error happens.
  */
+/* GoboRefined: icon from <folder>/.directory ([Desktop Entry] Icon=), or NULL.
+ * An absolute icon path is used only if that file exists. */
+static FmIcon* gobo_folder_custom_icon(const char* folder)
+{
+    char *dotdir = g_build_filename(folder, ".directory", NULL);
+    FmIcon *icon = NULL;
+    struct stat dst;
+
+    if (stat(dotdir, &dst) == 0 && S_ISREG(dst.st_mode) && dst.st_size < 65536)
+    {
+        GKeyFile *kf = g_key_file_new();
+        if (g_key_file_load_from_file(kf, dotdir, G_KEY_FILE_NONE, NULL))
+        {
+            char *name = g_key_file_get_string(kf, G_KEY_FILE_DESKTOP_GROUP,
+                                               G_KEY_FILE_DESKTOP_KEY_ICON, NULL);
+            if (name && *name &&
+                (!g_path_is_absolute(name) || g_file_test(name, G_FILE_TEST_IS_REGULAR)))
+                icon = fm_icon_from_name(name);
+            g_free(name);
+        }
+        g_key_file_free(kf);
+    }
+    g_free(dotdir);
+    return icon;
+}
