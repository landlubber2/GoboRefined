 #include <stdlib.h>
 #include <fnmatch.h>
+#include <grp.h>
+#include <string.h>
+#include <unistd.h>
+
+/* GoboRefined 0.9.1: accounts of the kind "Simple" (members of the group "simple") see only
+ * their home folder, USB drives (/Mount/Media) and the Trash; other places are refused with a
+ * short message. This is for peace of mind, not a security boundary: the boundary is file
+ * permissions (private home folders) and no sudo. */
+int gobo_simple_user(void)
+{
+    static int cached = -1;
+    if (cached < 0)
+    {
+        struct group *gr = getgrnam("simple");
+        cached = 0;
+        if (gr)
+        {
+            gid_t list[512];
+            int i, n = getgroups(512, list);
+            if (getgid() == gr->gr_gid || getegid() == gr->gr_gid)
+                cached = 1;
+            for (i = 0; i < n; i++)
+                if (list[i] == gr->gr_gid)
+                    cached = 1;
+        }
+    }
+    return cached;
+}
+
+static gboolean gobo_under(const char *p, const char *root)
+{
+    size_t n;
+    if (!p || !root || !root[0])
+        return FALSE;
+    n = strlen(root);
+    return strncmp(p, root, n) == 0 && (p[n] == '\0' || p[n] == '/');
+}
+
+/* a folder (file system path) a Simple account may open */
+static gboolean gobo_simple_dir_ok(const char *dir)
+{
+    char *real = realpath(dir, NULL);
+    char *home_real = realpath(g_get_home_dir(), NULL);
+    const char *p = real ? real : dir;
+    gboolean ok = gobo_under(p, g_get_home_dir()) || gobo_under(p, home_real) ||
+                  gobo_under(p, "/Mount/Media") || gobo_under(p, "/media");
+    /* a relative or odd path never counts */
+    if (p[0] != '/' || strstr(p, "/../") || g_str_has_suffix(p, "/.."))
+        ok = FALSE;
+    free(real);
+    free(home_real);
+    return ok;
+}
+
+gboolean gobo_simple_path_ok(FmPath *path)
+{
+    char *s;
+    gboolean ok = FALSE;
+    if (!gobo_simple_user() || path == NULL)
+        return TRUE;
+    if (fm_path_is_trash(path))
+        return TRUE;
+    s = fm_path_to_str(path);
+    if (fm_path_is_native(path))
+        ok = gobo_simple_dir_ok(s);
+    else if (g_str_has_prefix(s, "search:/"))
+    {
+        /* PCManFM's search results (search:///FOLDER?name=...): only inside allowed folders */
+        char *dir = g_strdup(s + strlen("search:"));
+        char *q = strchr(dir, '?');
+        char *d = dir;
+        if (q) *q = '\0';
+        while (d[0] == '/' && d[1] == '/') d++;
+        {
+            char *unesc = g_uri_unescape_string(d, NULL);
+            ok = unesc && gobo_simple_dir_ok(unesc);
+            g_free(unesc);
+        }
+        g_free(dir);
+    }
+    g_free(s);
+    return ok;
+}
+
+void gobo_simple_refuse(GtkWidget *parent)
+{
+    GtkWidget *top = parent ? gtk_widget_get_toplevel(parent) : NULL;
+    GtkWidget *dlg = gtk_message_dialog_new(top && gtk_widget_is_toplevel(top) ? GTK_WINDOW(top) : NULL,
+        GTK_DIALOG_MODAL | GTK_DIALOG_DESTROY_WITH_PARENT, GTK_MESSAGE_INFO, GTK_BUTTONS_OK,
+        "This place is not available in this account.");
+    gtk_message_dialog_format_secondary_text(GTK_MESSAGE_DIALOG(dlg),
+        "Your files are in your home folder, on USB drives and in the Trash.");
+    gtk_window_set_title(GTK_WINDOW(dlg), "Files");
+    gtk_dialog_run(GTK_DIALOG(dlg));
+    gtk_widget_destroy(dlg);
+}
 
