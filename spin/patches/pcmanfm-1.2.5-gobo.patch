+/* GoboRefined: simple search (Ctrl+F, toolbar button): a name and two modes,
+ * "this folder only" or "this folder and every folder inside it". It opens a
+ * search:// tab of libfm's search module; the old dialog stays as Advanced Search. */
+static gboolean quick_search_recursive = TRUE; /* last choice, kept while PCManFM runs */
+
+static void on_quick_search(GtkAction* act, FmMainWin* win)
+{
+    FmPath *cwd = fm_tab_page_get_cwd(win->current_page);
+    FmPath *folder;
+    GtkWidget *dlg, *box, *label, *entry, *only_here, *below;
+    char *dir_str, *disp, *markup;
+
+    /* in a search result (or another non-local place) search the home folder */
+    if (cwd && fm_path_is_native(cwd))
+        folder = fm_path_ref(cwd);
+    else
+        folder = fm_path_ref(fm_path_get_home());
+    dir_str = fm_path_to_str(folder);
+    disp = fm_path_display_basename(folder);
+
+    dlg = gtk_dialog_new_with_buttons(_("Search"), GTK_WINDOW(win),
+                                      GTK_DIALOG_MODAL | GTK_DIALOG_DESTROY_WITH_PARENT,
+                                      _("_Cancel"), GTK_RESPONSE_CANCEL,
+                                      _("_Search"), GTK_RESPONSE_OK, NULL);
+    gtk_dialog_set_default_response(GTK_DIALOG(dlg), GTK_RESPONSE_OK);
+    gtk_window_set_default_size(GTK_WINDOW(dlg), 420, -1);
+    gtk_window_set_icon_name(GTK_WINDOW(dlg), "edit-find");
+    box = gtk_dialog_get_content_area(GTK_DIALOG(dlg));
+    gtk_container_set_border_width(GTK_CONTAINER(box), 12);
+    gtk_box_set_spacing(GTK_BOX(box), 8);
+
+    label = gtk_label_new(_("Find files and folders whose name contains:"));
+    gtk_misc_set_alignment(GTK_MISC(label), 0.0, 0.5);
+    gtk_box_pack_start(GTK_BOX(box), label, FALSE, FALSE, 0);
+    entry = gtk_entry_new();
+    gtk_entry_set_activates_default(GTK_ENTRY(entry), TRUE);
+    gtk_box_pack_start(GTK_BOX(box), entry, FALSE, FALSE, 0);
+
+    markup = g_strdup_printf(_("Only in this folder (%s)"), disp);
+    only_here = gtk_radio_button_new_with_label(NULL, markup);
+    g_free(markup);
+    below = gtk_radio_button_new_with_label_from_widget(GTK_RADIO_BUTTON(only_here),
+                    _("In this folder and all folders inside it"));
+    gtk_toggle_button_set_active(GTK_TOGGLE_BUTTON(quick_search_recursive ? below : only_here), TRUE);
+    gtk_box_pack_start(GTK_BOX(box), only_here, FALSE, FALSE, 0);
+    gtk_box_pack_start(GTK_BOX(box), below, FALSE, FALSE, 0);
+    label = gtk_label_new(_("Not case sensitive. * and ? work as wildcards."));
+    gtk_misc_set_alignment(GTK_MISC(label), 0.0, 0.5);
+    gtk_widget_set_sensitive(label, FALSE);
+    gtk_box_pack_start(GTK_BOX(box), label, FALSE, FALSE, 0);
+    gtk_widget_show_all(dlg);
+
+    while (gtk_dialog_run(GTK_DIALOG(dlg)) == GTK_RESPONSE_OK)
+    {
+        const char *text = gtk_entry_get_text(GTK_ENTRY(entry));
+        char *pattern, *esc_dir, *esc_pat, *uri;
+        FmPath *search;
+
+        while (*text == ' ')
+            ++text;
+        if (*text == '\0')
+        {
+            gtk_widget_grab_focus(entry);
+            continue;
+        }
+        quick_search_recursive = gtk_toggle_button_get_active(GTK_TOGGLE_BUTTON(below));
+        /* a plain word matches anywhere in the name; with wildcards it is used as typed */
+        if (strchr(text, '*') || strchr(text, '?'))
+            pattern = g_strdup(text);
+        else
+            pattern = g_strdup_printf("*%s*", text);
+        /* same escaping as libfm's own search dialog (fm-gtk-file-launcher.c) */
+        esc_dir = g_uri_escape_string(dir_str, "!$&'()*+:;=/@", TRUE);
+        esc_pat = g_uri_escape_string(pattern, ":/?#[]@!$'()*+,;", TRUE);
+        uri = g_strdup_printf("search://%s?recursive=%c&show_hidden=0&name=%s&name_ci=1",
+                              esc_dir, quick_search_recursive ? '1' : '0', esc_pat);
+        search = fm_path_new_for_uri(uri);
+        /* like the old dialog: through the launcher, so the tab is titled "Search Results" */
+        gtk_widget_hide(dlg);
+        fm_launch_path_simple(GTK_WINDOW(win), NULL, search, pcmanfm_open_folder, NULL);
+        fm_path_unref(search);
+        g_free(uri);
+        g_free(esc_pat);
+        g_free(esc_dir);
+        g_free(pattern);
+        break;
+    }
+    gtk_widget_destroy(dlg);
+    g_free(disp);
+    g_free(dir_str);
+    fm_path_unref(folder);
+}
 #endif
 
