+/* GoboRefined 0.10.8: tabs can leave their window. "Move tab to new window" in the tab's right-click
+ * menu, or drag the tab out of the window (GtkNotebook detachable tabs, "create-window"); a tab
+ * dragged onto another window's tab bar joins that window. The last tab of a window stays (its
+ * window would close under the drag). Everything a window connects to a tab is done in
+ * on_notebook_page_added() / undone in on_notebook_page_removed(), so a moved tab works the same
+ * in its new window. */
+static FmMainWin* create_empty_main_win(void);
+
+static FmMainWin* main_win_of_page(FmTabPage* page)
+{
+    GtkWidget* top = gtk_widget_get_toplevel(GTK_WIDGET(page));
+    return IS_FM_MAIN_WIN(top) ? (FmMainWin*)top : NULL;
+}
+
+static void update_tabs_detachable(GtkNotebook* nb)
+{
+    gint i, n = gtk_notebook_get_n_pages(nb);
+    for (i = 0; i < n; i++)
+        gtk_notebook_set_tab_detachable(nb, gtk_notebook_get_nth_page(nb, i), n > 1);
+}
+
+static void move_tab_to_new_win(FmTabPage* page)
+{
+    FmMainWin* win = main_win_of_page(page);
+    FmMainWin* new_win;
+    GtkWidget* label;
+    gint n;
+    if (!win || gtk_notebook_get_n_pages(win->notebook) < 2)
+        return;
+    label = GTK_WIDGET(page->tab_label);
+    g_object_ref(page);
+    g_object_ref(label);
+    gtk_container_remove(GTK_CONTAINER(win->notebook), GTK_WIDGET(page));
+    new_win = create_empty_main_win();
+    n = gtk_notebook_append_page(new_win->notebook, GTK_WIDGET(page), label);
+    gtk_notebook_set_tab_reorderable(new_win->notebook, GTK_WIDGET(page), TRUE);
+    gtk_notebook_set_current_page(new_win->notebook, n);
+    g_object_unref(label);
+    g_object_unref(page);
+    gtk_window_present(GTK_WINDOW(new_win));
+}
+
+static GtkNotebook* on_notebook_create_window(GtkNotebook* nb, GtkWidget* page, gint x, gint y, FmMainWin* win)
