#!/bin/bash
# gobo-update — whole-system updates for GoboRefined (A/B system versions on btrfs, 0.10).
#
#   sudo gobo-update FILE                  install GoboRefined-<version>.update as the other version
#   sudo gobo-update --status              show both versions, what starts next, the free space
#   sudo gobo-update --rollback            start the other version from the next restart on
#   sudo gobo-update --reset-system-changes
#                                          at the next restart, forget all changes made to system
#                                          files since the install (accounts and home folders stay)
#
# The disk (0.10, docs/ab-design.md): GOBO_BOOT (FAT: GRUB, grubenv, gobo/a and gobo/b with each
# version's kernel, initramfs and gobo-slot.env) and GOBO_POOL (btrfs: @system-a, @system-b,
# @data, @swap). An update: the other version's subvolume is deleted, the running one is snapshotted
# in its place (instant, shares every file) and the new image is copied over it with rsync (only
# changed files are written). The running version is never written. A new version is only offered
# after it was verified, copied and checked (gobo-slot.env on GOBO_BOOT is written last); GRUB then
# tries it twice and goes back to the old version by itself if it does not start.
# --boot-task is run by the boot scripts (not by hand).
# The ext4 layout of 0.8-0.9.x is refused: those computers are reinstalled for 0.10.
set -euo pipefail
umask 022

PUBKEY=/Programs/GoboSpin/Current/share/gobo-update/update-signing.pub.pem
STATE=/Data/Variable/lib/gobo-update      # root-owned: lock, notice for the desktop, version names
LOG=/Data/Variable/log/gobo-update.log
OVERLAY=/System/Data/System-Overlay       # subvolume @data, mounted by the initramfs
TRAILER_SIZE=8192
# 0.10: format 2. A 0.9.x gobo-update accepts only "GOBOREFINED-UPDATE 1" and so refuses a 0.10 file
# before it writes anything (it would put the btrfs-only system into an ext4 slot).
TRAILER_MAGIC="GOBOREFINED-UPDATE 2"
POOL_OPTS=noatime,compress=zstd:3
MARGIN=$((2 * 1024 * 1024 * 1024))       # free space kept on top of what an update writes
APPLY_LOOK=/Programs/GoboSpin/Current/share/gobo11/apply.sh
ASSUME_YES=0

c_cyan=$'\033[1;36m'; c_red=$'\033[1;31m'; c_off=$'\033[0m'
[ -t 1 ] || { c_cyan=""; c_red=""; c_off=""; }
log()  { mkdir -p "${LOG%/*}"; echo "$(date '+%F %T') $*" >> "$LOG" 2>/dev/null || true; }
say()  { echo "$*"; log "$*"; }
step() { echo "${c_cyan}==> $*${c_off}"; log "==> $*"; }
die()  { echo "${c_red}gobo-update: $*${c_off}" >&2; log "ERROR: $*"; exit 1; }

usage() { sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; }

### Where we are ###############################################################

cmdline_arg() { # cmdline_arg NAME -> value of NAME=... on the kernel command line
   local w
   for w in $(cat /proc/cmdline)
   do case "$w" in "$1="*) echo "${w#*=}"; return 0 ;; esac
   done
   return 0
}

uuid_of() { # "UUID=x" -> x (letters, digits and - only)
   case "$1" in UUID=*) [[ "${1#UUID=}" =~ ^[0-9A-Fa-f-]+$ ]] && echo "${1#UUID=}" ;; esac
   return 0
}

load_layout() {
   [ "$(cmdline_arg root)" = gobo ] || die "this system was not started from an A/B layout (no root=gobo)"
   [ "$(cmdline_arg gobo.layout)" = btrfs ] ||
      die "this computer has the disk layout of GoboRefined 0.8-0.9.x (ext4 slots). GoboRefined 0.10 and later need a new installation from the 0.10 ISO (back up /Users first); nothing was changed"
   CUR=$(cmdline_arg gobo.slot)
   case "$CUR" in a) OTHER=b ;; b) OTHER=a ;; *) die "unknown running version '$CUR'" ;; esac
   POOL_UUID=$(uuid_of "$(cmdline_arg gobo.root)")
   BOOT_UUID=$(uuid_of "$(cmdline_arg gobo.boot)")
   [ -n "$POOL_UUID" ] && [ -n "$BOOT_UUID" ] || die "gobo.root= / gobo.boot= missing on the kernel command line"
   [ "$(uuid_of "$(cmdline_arg gobo.data)")" = "$POOL_UUID" ] || die "gobo.data= is not the pool on the kernel command line"
   MODE=normal
   [ "$(cmdline_arg gobo.system-changes)" = off ] && MODE=safe
   CUR_VERSION=$(slot_version_in /System/Slot)
   return 0
}

# NB: "grub-editenv FILE list" CREATES a missing FILE - and GRUB offers a version as soon as
# gobo/<x>/gobo-slot.env exists. So every reader checks that the file is there first.
env_version() { # env_version FILE -> slot_version in FILE, or empty
   [ -f "$1" ] || return 0
   { grub-editenv "$1" list 2>/dev/null || true; } | sed -n 's/^slot_version=//p' | head -n 1 | tr -dc '0-9A-Za-z.-'
}
slot_version_in() { env_version "$1/gobo-slot.env"; }   # a system tree (subvolume)
boot_version() { env_version "$BOOT/gobo/$1/gobo-slot.env"; }   # what GRUB offers (needs mount_boot)

letter_upper() { [ "$1" = a ] && echo A || echo B; }

TMP=""
BOOT=""
POOL=""
LOOP=""
cleanup() {
   local m
   set +e
   if [ -n "$TMP" ]
   then
      for m in "$TMP/sq" "$TMP/pool" "$TMP/boot"
      do mountpoint -q "$m" 2>/dev/null && { umount "$m" || umount -l "$m"; }
      done
      [ -n "$LOOP" ] && losetup -d "$LOOP" 2>/dev/null
      rm -rf "$TMP"
   fi
}
trap cleanup EXIT

need_root() { [ "$(id -u)" = 0 ] || die "must be run as root (sudo gobo-update ...)"; }

lock() {
   mkdir -p "$STATE"; chmod 755 "$STATE"
   exec 9> "$STATE/lock"
   flock -n 9 || die "another gobo-update is running"
}

make_tmp() { [ -n "$TMP" ] || TMP=$(mktemp -d /tmp/gobo-update.XXXXXX); }

mount_boot() { # mounts GOBO_BOOT at $TMP/boot and checks that its grub.cfg is this computer's btrfs layout
   local dev
   make_tmp
   [ -n "$BOOT" ] && return 0
   dev=$(blkid -U "$BOOT_UUID" 2>/dev/null) || true
   [ -n "$dev" ] && [ -b "$dev" ] || die "boot partition (UUID $BOOT_UUID) not found"
   [ "$(blkid -s LABEL -o value "$dev")" = GOBO_BOOT ] || die "$dev is not labelled GOBO_BOOT"
   mkdir -p "$TMP/boot"
   mount -t vfat -o umask=0077 "$dev" "$TMP/boot" || die "cannot mount the boot partition $dev"
   BOOT="$TMP/boot"
   [ -f "$BOOT/grub/grub.cfg" ] && [ -f "$BOOT/grub/grubenv" ] || die "no grub.cfg/grubenv on the boot partition"
   grep -qx 'set gobo_layout=btrfs' "$BOOT/grub/grub.cfg" && grep -qx "set gobo_uuid_pool=$POOL_UUID" "$BOOT/grub/grub.cfg" ||
      die "grub.cfg on the boot partition is not the btrfs layout of this computer"
   L_partuuid_pool=$(sed -n 's/^set gobo_partuuid_pool=\([0-9A-Fa-f-]*\)$/\1/p' "$BOOT/grub/grub.cfg" | head -n 1)
   [ -n "$L_partuuid_pool" ] || die "grub.cfg has no gobo_partuuid_pool"
}

mount_pool() { # mounts the top level of GOBO_POOL at $TMP/pool (the subvolumes are folders there)
   local dev
   make_tmp
   [ -n "$POOL" ] && return 0
   dev=$(blkid -U "$POOL_UUID" 2>/dev/null) || true
   [ -n "$dev" ] && [ -b "$dev" ] || die "the system pool (UUID $POOL_UUID) not found"
   [ "$(blkid -s TYPE -o value "$dev")" = btrfs ] && [ "$(blkid -s LABEL -o value "$dev")" = GOBO_POOL ] ||
      die "$dev is not the btrfs partition GOBO_POOL"
   mkdir -p "$TMP/pool"
   mount -t btrfs -o "subvolid=5,$POOL_OPTS" "$dev" "$TMP/pool" || die "cannot mount the system pool $dev"
   POOL="$TMP/pool"
}

subvol_uuid() { # subvol_uuid PATH -> the btrfs UUID of the subvolume at PATH, or empty
   { btrfs subvolume show "$1" 2>/dev/null || true; } | sed -n 's/^[[:space:]]*UUID:[[:space:]]*\([0-9a-f-]*\)$/\1/p' | head -n 1
}

env_get() { grub-editenv "$BOOT/grub/grubenv" list | sed -n "s/^$1=//p" | head -n 1; }

env_write() { # env_write set k=v ... | unset k ...   (several: env_write set a=1 -- unset b)
   local f="$BOOT/grub/grubenv"
   cp "$f" "$f.new"
   while [ $# -gt 0 ]
   do
      case "$1" in
         set)   shift; while [ $# -gt 0 ] && [ "$1" != -- ]; do grub-editenv "$f.new" set "$1"; shift; done ;;
         unset) shift; while [ $# -gt 0 ] && [ "$1" != -- ]; do grub-editenv "$f.new" unset "$1"; shift; done ;;
         --)    shift ;;
         *)     die "env_write: $1" ;;
      esac
   done
   sync
   mv -f "$f.new" "$f"
   sync
   log "grubenv: $(grub-editenv "$f" list | tr '\n' ' ')"
}

human() { awk -v b="$1" 'BEGIN { if (b >= 1073741824) printf "%.1f GB", b / 1073741824; else printf "%d MB", b / 1048576 }'; }

pool_free() { # pool_free PATH -> estimated free bytes of the btrfs file system holding PATH
   { btrfs filesystem usage -b "$1" 2>/dev/null || true; } | sed -n 's/^[[:space:]]*Free (estimated):[[:space:]]*\([0-9]*\).*/\1/p' | head -n 1
}

### Update file ################################################################

# The file is checked and then read a second time (mounted as a squashfs). So that nobody can swap or
# change it in between (without needing free space for a copy):
#  - it is opened ONCE, as file descriptor 8; the check and the loop device both use that open file
#    through /proc/self/fd/8 (a re-open of the same inode), so renaming, replacing or re-linking the
#    path after the check has no effect;
#  - the open file must be a regular file owned by root or by the user who ran sudo, and not
#    writable by group or others: then only root or that user (the administrator doing the update)
#    could change its contents in place, and both are trusted anyway;
#  - after copying, its size and modification time (taken from the open file) must be unchanged.
# Not covered: someone with physical access rewriting a USB stick's sectors behind the kernel's back.
UPD_FD=/proc/self/fd/8
open_update() { # open_update FILE
   local f="$1" owner mode invoker
   [ -f "$f" ] && [ -r "$f" ] || die "cannot read $f"
   exec 8< "$f" || die "cannot open $f"
   [ -f "$UPD_FD" ] || die "$f is not a regular file"
   read -r owner mode U_FILE_SIZE U_FILE_MTIME <<< "$(stat -L -c '%u %a %s %Y' "$UPD_FD")"
   invoker=0
   [[ "${SUDO_UID:-}" =~ ^[0-9]+$ ]] && invoker=$SUDO_UID
   [ "$owner" = 0 ] || [ "$owner" = "$invoker" ] ||
      die "$f belongs to another user (uid $owner); copy it to a folder of your own first"
   (( (8#$mode & 8#022) == 0 )) ||
      die "$f may be changed by other users (mode $mode); run: chmod go-w \"$f\" (or copy it to your home folder)"
   return 0
}

update_unchanged() { # the open file has the same size and modification time as when it was checked
   [ "$(stat -L -c '%s %Y' "$UPD_FD")" = "$U_FILE_SIZE $U_FILE_MTIME" ]
}

verify_update() { # verify_update DISPLAYNAME (reads the file opened by open_update): sets U_VERSION, U_IMAGE_SIZE, U_INSTALLED
   local f="$UPD_FD" size sum expect first   # $1 = the name shown in messages
   [ -f "$PUBKEY" ] || die "public key $PUBKEY missing"
   make_tmp
   size=$(stat -L -c %s "$f")
   [ "$size" -gt $((TRAILER_SIZE * 2)) ] || die "$1 is too small to be an update"
   tail -c $TRAILER_SIZE "$f" > "$TMP/trailer"
   first=$(head -n 1 "$TMP/trailer" | tr -d '\000')
   [ "$first" != "GOBOREFINED-UPDATE 1" ] ||
      die "$1 is an update for GoboRefined 0.8-0.9.x (the ext4 layout); it cannot be installed on 0.10 or later"
   [ "$first" = "$TRAILER_MAGIC" ] || die "$1 is not a GoboRefined update file (for this layout)"
   sed '/^-----BEGIN SIGNATURE-----$/,$d' "$TMP/trailer" > "$TMP/manifest"
   sed -n '/^-----BEGIN SIGNATURE-----$/,/^-----END SIGNATURE-----$/p' "$TMP/trailer" | sed '1d;$d' |
      openssl base64 -d -A > "$TMP/sig" 2>/dev/null || true
   [ -s "$TMP/sig" ] || die "the update file is not signed"
   openssl dgst -sha256 -verify "$PUBKEY" -signature "$TMP/sig" "$TMP/manifest" > /dev/null 2>&1 ||
      die "the signature does not match: the file was not made by GoboRefined or was changed"
   mf() { sed -n "s/^$1=//p" "$TMP/manifest" | head -n 1; }
   [ "$(mf name)" = GoboRefined ] || die "not a GoboRefined update"
   [ "$(mf layout)" = btrfs ] || die "$1 is not made for the btrfs layout"
   U_VERSION=$(mf version)
   U_IMAGE_SIZE=$(mf image_size)
   U_INSTALLED=$(mf installed_bytes)
   expect=$(mf image_sha256)
   [[ "$U_VERSION" =~ ^[0-9A-Za-z.-]+$ ]] || die "bad version in the manifest"
   [[ "$U_IMAGE_SIZE" =~ ^[0-9]+$ ]] && [[ "$U_INSTALLED" =~ ^[0-9]+$ ]] || die "bad sizes in the manifest"
   [[ "$expect" =~ ^[0-9a-f]{64}$ ]] || die "bad checksum in the manifest"
   [ "$size" -eq $((U_IMAGE_SIZE + TRAILER_SIZE)) ] || die "the file has the wrong size (incomplete download?)"
   step "Checking the file (GoboRefined $U_VERSION, $((size / 1048576)) MB)"
   sum=$(head -c "$U_IMAGE_SIZE" "$f" | sha256sum | cut -d' ' -f1)
   [ "$sum" = "$expect" ] || die "checksum mismatch: the file is damaged"
   say "    signature and checksum are correct"
}

### Boot menu ##################################################################
# GRUB itself (BOOTX64.EFI / the BIOS core image and the modules on GOBO_BOOT) stays as installed:
# it is never updated. Only grub.cfg can be: when the new system carries a boot menu template
# (share/gobo-update/grub.cfg.in) with a higher "gobo-grub-template N" than the installed grub.cfg,
# grub.cfg is written from it with this computer's IDs, atomically (new file, sync, rename); the
# previous one is kept as grub.cfg.old. The template must start both versions.

template_version() { # template_version FILE -> N from "# gobo-grub-template N" in line 1, else 0
   local v
   v=$(sed -n '1s/^# gobo-grub-template \([0-9]\{1,4\}\)$/\1/p' "$1" 2>/dev/null)
   echo "${v:-0}"
}

update_boot_menu() { # update_boot_menu NEWTREE (needs mount_boot)
   local tpl="$1/Programs/GoboSpin/Current/share/gobo-update/grub.cfg.in" cfg="$BOOT/grub/grub.cfg" vnew vold video
   [ -f "$tpl" ] || { log "boot menu: the new system has no template; grub.cfg kept"; return 0; }
   vnew=$(template_version "$tpl"); vold=$(template_version "$cfg")
   if [ "$vnew" -le "$vold" ]
   then log "boot menu: template $vnew, installed $vold: grub.cfg kept"; return 0
   fi
   # The video line depends on the firmware the computer was installed for.
   if grep -qx 'insmod all_video' "$cfg"; then video="insmod all_video"
   elif grep -qx 'insmod vbe' "$cfg"; then video="insmod vbe"
   else say "    the installed boot menu is not recognised; it is kept as it is"; return 0
   fi
   sed -e "s|@UUID_BOOT@|$BOOT_UUID|g" -e "s|@UUID_POOL@|$POOL_UUID|g" -e "s|@PARTUUID_POOL@|$L_partuuid_pool|g" \
       -e "s|@VIDEO@|$video|g" "$tpl" > "$cfg.new" || die "could not write the new boot menu"
   # Checks: all placeholders filled, this computer's IDs in it, GRUB's own syntax check, and no
   # escaped "\$" (a template written through a shell here-document by mistake).
   if grep -qE '@[A-Z_]+@' "$cfg.new" || ! grep -qx "set gobo_uuid_pool=$POOL_UUID" "$cfg.new" ||
      ! grep -qx 'set gobo_layout=btrfs' "$cfg.new" || grep -qF '\$' "$cfg.new" ||
      { command -v grub-script-check > /dev/null && ! grub-script-check "$cfg.new" > /dev/null 2>&1; }
   then
      rm -f "$cfg.new"
      say "    the new boot menu template does not fit this computer; the old boot menu is kept"
      return 0
   fi
   sync
   cp -f "$cfg" "$cfg.old"
   sync
   mv -f "$cfg.new" "$cfg"
   sync
   say "    boot menu updated (template $vold -> $vnew; the old one is kept as grub/grub.cfg.old)"
}

### Update #####################################################################

tree_file() { # tree_file TREE LINK -> the file LINK (inside TREE) points to, as a path inside TREE
   local p
   p=$(chroot "$1" /System/Index/bin/readlink -f "$2" 2>/dev/null) || return 1
   case "$p" in /Programs/?*|/System/Kernel/Boot/?*) ;; *) return 1 ;; esac
   case "$p" in *..*) return 1 ;; esac
   [ -f "$1$p" ] || return 1
   echo "$p"
}

cmd_update() {
   local file cur new cur_id dry free back need t kpath ipath reply
   file=$(readlink -f "$1")
   need_root; load_layout; lock
   [ "$MODE" = normal ] || die "started without the system changes: restart normally to update"
   open_update "$file"
   verify_update "$file"
   mount_boot; mount_pool
   cur=$POOL/@system-$CUR new=$POOL/@system-$OTHER
   # Never the running version: the subvolume at /System/Slot (by its btrfs UUID) must be @system-CUR
   # and must not be @system-OTHER.
   cur_id=$(subvol_uuid /System/Slot)
   [ -n "$cur_id" ] || die "cannot identify the running version's subvolume"
   [ "$(subvol_uuid "$cur")" = "$cur_id" ] || die "@system-$CUR is not the running version"
   if [ -e "$new" ]
   then
      [ "$(subvol_uuid "$new")" != "$cur_id" ] || die "@system-$OTHER is the running version"
      [ -n "$(subvol_uuid "$new")" ] || die "$new is not a btrfs subvolume; refusing to touch it"
   fi
   say "Running: $(letter_upper "$CUR") (GoboRefined ${CUR_VERSION:-?}). The update goes to $(letter_upper "$OTHER") (@system-$OTHER)."
   if [ "$ASSUME_YES" != 1 ] && [ -t 0 ]
   then
      read -r -p "Install GoboRefined $U_VERSION as version $(letter_upper "$OTHER")? Its old content is deleted. [y/N] " reply
      case "$reply" in y|Y|yes) ;; *) die "nothing was changed" ;; esac
   fi

   # The new image, read through the open file (fd 8): a loop device limited to the image part.
   mkdir -p "$TMP/sq"
   LOOP=$(losetup -r -f --show --sizelimit "$U_IMAGE_SIZE" "$UPD_FD") || die "could not attach the update file"
   mount -t squashfs -o ro "$LOOP" "$TMP/sq" || die "cannot mount the update's image"

   # Free space, before anything is changed: what rsync would write over a copy of the running version
   # (dry run against the running version itself; the snapshot made below is identical to it) plus a
   # margin, against the pool's free space plus what deleting the other version gives back.
   step "Checking the free space"
   t=$SECONDS
   dry=$( { rsync -aHAX --numeric-ids --delete --dry-run --stats "$TMP/sq/" "$cur/" 2>> "$LOG" || true; } |
         sed -n 's/^Total transferred file size: \([0-9,]*\) bytes.*/\1/p' | tr -d ,)
   [[ "$dry" =~ ^[0-9]+$ ]] || die "could not work out the size of the update (rsync dry run)"
   free=$(pool_free "$POOL"); [[ "$free" =~ ^[0-9]+$ ]] || die "could not read the free space of the pool"
   back=0
   if [ -e "$new" ]
   then
      back=$( { btrfs filesystem du -s --raw "$new" 2>/dev/null || true; } | awk 'NR == 2 { print $2 }')
      [[ "$back" =~ ^[0-9]+$ ]] || back=0
   fi
   need=$((dry + MARGIN))
   log "space: writes $dry bytes; free $free; deleting @system-$OTHER gives back about $back; dry run $((SECONDS - t)) s"
   [ $((free + back)) -ge "$need" ] ||
      die "not enough free space: the update writes up to $(human "$dry") (and keeps $(human "$MARGIN") free), the disk has $(human "$((free + back))") available; nothing was changed. Free some space (e.g. old files in /Users) and try again"
   say "    writes about $(human "$dry"); $(human "$free") free"

   # From here on version OTHER is incomplete: make sure nothing chooses it until it is done.
   step "Setting $(letter_upper "$OTHER") aside"
   if [ "$(env_get try_slot)" = "$OTHER" ] || [ "$(env_get slot)" = "$OTHER" ]
   then env_write set "slot=$CUR" -- unset try_slot tries_left
   fi
   rm -f "$BOOT/gobo/$OTHER/gobo-slot.env"
   sync
   rm -f "$BOOT/gobo/$OTHER/kernel" "$BOOT/gobo/$OTHER/initramfs" "$BOOT/gobo/$OTHER/"*.new
   echo "" > "$STATE/slot-$OTHER"
   if [ -e "$new" ]
   then
      btrfs property set -ts "$new" ro false >> "$LOG" 2>&1 || true
      btrfs subvolume delete "$new" >> "$LOG" 2>&1 || die "cannot delete @system-$OTHER"
   fi
   btrfs subvolume snapshot "$cur" "$new" >> "$LOG" 2>&1 || die "could not make a snapshot of @system-$CUR"
   rm -f "$new/gobo-slot.env"
   sync

   step "Copying GoboRefined $U_VERSION (only the files that changed)"
   t=$SECONDS
   rsync -aHAX --numeric-ids --delete --stats "$TMP/sq/" "$new/" > "$TMP/rsync.out" 2>> "$LOG" || die "copying failed (rsync); version $(letter_upper "$OTHER") stays empty"
   grep -E '^(Number of regular files transferred|Number of deleted files|Total transferred file size)' "$TMP/rsync.out" | sed "s/^/    /" | tee -a "$LOG" || true
   log "copied in $((SECONDS - t)) s"
   umount "$TMP/sq"; losetup -d "$LOOP"; LOOP=""
   update_unchanged || die "the update file was changed while it was being installed; version $(letter_upper "$OTHER") stays empty"
   exec 8<&-

   step "Checking the new system"
   for p in System/Kernel/Boot/kernel System/Kernel/Boot/initramfs System/Index/bin/gobo-update Programs/Scripts
   do [ -e "$new/$p" ] || [ -L "$new/$p" ] || die "the new system has no $p"
   done
   [ "$(head -n 1 "$new/Programs/GoboSpin/Current/share/spin-version" | tr -dc '0-9A-Za-z.-')" = "$U_VERSION" ] ||
      die "the new system's version does not match the update file"
   kpath=$(tree_file "$new" /System/Kernel/Boot/kernel) || die "the new system's kernel was not found"
   ipath=$(tree_file "$new" /System/Kernel/Boot/initramfs) || die "the new system's initramfs was not found"
   update_boot_menu "$new"

   step "Kernel and initramfs to the boot partition"
   mkdir -p "$BOOT/gobo/$OTHER"
   cp "$new$kpath" "$BOOT/gobo/$OTHER/kernel.new" && cp "$new$ipath" "$BOOT/gobo/$OTHER/initramfs.new" ||
      die "could not copy the kernel to the boot partition (full?)"
   sync
   mv -f "$BOOT/gobo/$OTHER/kernel.new" "$BOOT/gobo/$OTHER/kernel"
   mv -f "$BOOT/gobo/$OTHER/initramfs.new" "$BOOT/gobo/$OTHER/initramfs"
   # The initramfs reads the version's own gobo-slot.env; then the subvolume becomes read-only.
   grub-editenv "$new/gobo-slot.env" create
   grub-editenv "$new/gobo-slot.env" set "slot_version=$U_VERSION"
   sync
   btrfs property set -ts "$new" ro true >> "$LOG" 2>&1 || die "cannot make @system-$OTHER read-only"
   # Written last: GRUB offers the new version from here on.
   grub-editenv "$BOOT/gobo/$OTHER/gobo-slot.env.new" create
   grub-editenv "$BOOT/gobo/$OTHER/gobo-slot.env.new" set "slot_version=$U_VERSION"
   sync
   mv -f "$BOOT/gobo/$OTHER/gobo-slot.env.new" "$BOOT/gobo/$OTHER/gobo-slot.env"
   sync
   echo "$U_VERSION" > "$STATE/slot-$OTHER"

   env_write set "try_slot=$OTHER" "tries_left=2"
   say "    $(human "$(pool_free "$POOL")") free on the disk"
   umount "$BOOT"; BOOT=""
   umount "$POOL"; POOL=""
   step "Done"
   say "GoboRefined $U_VERSION is ready as version $(letter_upper "$OTHER"). It starts at the next restart."
   say "If it does not start, the computer goes back to ${CUR_VERSION:-the current version} by itself."
   log "update to $U_VERSION in $OTHER finished in $SECONDS s"
   if [ "$ASSUME_YES" != 1 ] && [ -t 0 ]
   then
      read -r -p "Restart now? [y/N] " reply
      case "$reply" in y|Y|yes) cleanup; trap - EXIT; exec reboot ;; esac
   fi
}

### Status, rollback, reset ####################################################

cmd_status() {
   local v def try left rb name free
   need_root; load_layout; mount_boot
   def=$(env_get slot); [ "$def" = b ] || def=a
   try=$(env_get try_slot); left=$(env_get tries_left); rb=$(env_get rollback_from)
   echo "GoboRefined system versions"
   for s in a b
   do
      v=$(boot_version "$s")
      if [ "$s" = "$CUR" ]; then name="${CUR_VERSION:-${v:-?}}"; else name="${v:-empty}"; fi
      printf '  %s  %-14s' "$(letter_upper $s)" "$name"
      [ "$s" = "$CUR" ] && printf ' [running%s]' "$([ "$MODE" = safe ] && echo ', WITHOUT system changes')"
      [ "$s" = "$def" ] && printf ' [default]'
      [ "$s" = "$try" ] && printf ' [new: being tried, %s tries left]' "${left:-0}"
      echo
   done
   if [ "$try" = a ] || [ "$try" = b ]
   then echo "  next start: $(letter_upper "$try") (if it does not start: $(letter_upper "$def"))"
   else echo "  next start: $(letter_upper "$def")"
   fi
   [ -n "$rb" ] && echo "  $(letter_upper "$rb") did not start and was set aside (rollback)"
   if [ -f "$STATE/notice" ] && grep -q '^kind=rolled-back' "$STATE/notice"
   then echo "  last rollback: $(sed -n 's/^failed_version=//p' "$STATE/notice") did not start ($(sed -n 's/^date=//p' "$STATE/notice"))"
   fi
   if [ -d "$OVERLAY/upper" ]
   then echo "  system changes since the install: $(du -sh "$OVERLAY/upper" 2>/dev/null | cut -f1)$([ -e "$OVERLAY/reset-requested" ] && echo ' (will be removed at the next start)')"
   fi
   free=$(pool_free /System/Data)
   if [[ "$free" =~ ^[0-9]+$ ]]
   then echo "  free on the disk (system versions and your files share it): $(human "$free")"
   fi
}

cmd_rollback() {
   local v
   need_root; load_layout; lock; mount_boot; mount_pool
   v=$(boot_version "$OTHER")
   [ -n "$v" ] && [ -f "$POOL/@system-$OTHER/gobo-slot.env" ] && [ -f "$BOOT/gobo/$OTHER/kernel" ] ||
      die "version $(letter_upper "$OTHER") is empty or incomplete: nothing to go back to"
   env_write set "slot=$OTHER" -- unset try_slot tries_left
   say "From the next restart on, version $(letter_upper "$OTHER") (GoboRefined $v) starts."
}

cmd_reset() {
   need_root; load_layout; lock
   [ -d "$OVERLAY" ] || die "$OVERLAY not found"
   if [ "$ASSUME_YES" != 1 ]
   then
      echo "At the next restart all changes made to system files since the install are removed"
      echo "(programs you compiled, edited settings in /System/Settings, ...). Kept: user accounts"
      echo "and passwords, home folders, /Data. The removed changes stay in"
      echo "$OVERLAY/previous-upper until the next reset."
      read -r -p "Type 'yes' to continue: " reply
      [ "$reply" = yes ] || die "nothing was changed"
   fi
   : > "$OVERLAY/reset-requested"
   sync
   say "System changes will be removed at the next restart."
}

### Boot task (BootUp) #########################################################

notice() { # notice KIND key=value ...: one notice for the desktop (spin/updates.lua shows it once)
   local kind="$1"; shift
   mkdir -p "$STATE"
   {
      echo "id=$(date +%s)-$kind"
      echo "kind=$kind"
      echo "date=$(date '+%F %R')"
      # 0.8.2: the people who had an account when this happened; accounts made later never
      # see the notice (spin/updates.lua)
      echo "users=,$(awk -F: '$3 >= 1000 && $3 < 60000 { printf "%s,", $1 }' /System/Settings/passwd 2>/dev/null)"
      for kv in "$@"; do echo "$kv"; done
   } > "$STATE/notice.new"
   chmod 644 "$STATE/notice.new"
   mv -f "$STATE/notice.new" "$STATE/notice"
}

user_programs_present() { # a program version that is not part of the slot's image
   local d
   for d in /Programs/*/*/
   do
      d=${d%/}
      case "${d##*/}" in Current|Settings|Variable) continue ;; esac
      [ -L "$d" ] && continue
      [ -e "/System/Slot$d" ] || { log "user program: $d"; return 0; }
   done
   return 1
}

regenerate_caches() {
   local d
   ldconfig
   if ! user_programs_present
   then log "no programs added by the user: the image's caches are used"; return 0
   fi
   step "Updating caches for the programs you added"
   command -v fc-cache > /dev/null && fc-cache > /dev/null 2>&1
   for d in /System/Index/share/icons/*/
   do [ -f "$d/index.theme" ] && gtk-update-icon-cache -q -f "$d" > /dev/null 2>&1
   done
   command -v update-mime-database > /dev/null && update-mime-database /System/Index/share/mime > /dev/null 2>&1
   command -v gdk-pixbuf-query-loaders > /dev/null && gdk-pixbuf-query-loaders --update-cache > /dev/null 2>&1
   command -v gio-querymodules > /dev/null && gio-querymodules /System/Index/lib/gio/modules > /dev/null 2>&1
   command -v glib-compile-schemas > /dev/null && glib-compile-schemas /System/Index/share/glib-2.0/schemas > /dev/null 2>&1
   command -v gtk-query-immodules-3.0 > /dev/null && gtk-query-immodules-3.0 --update-cache > /dev/null 2>&1
   # 0.9.4: the image has no update-desktop-database; gobo-settings-helper writes mimeinfo.cache
   if command -v update-desktop-database > /dev/null
   then update-desktop-database /System/Index/share/applications > /dev/null 2>&1
   elif [ -x /System/Index/bin/gobo-settings-helper ]
   then /System/Index/bin/gobo-settings-helper boot-apps > /dev/null 2>&1 || true
   fi
   return 0
}

# New system accounts of a new image. The machine's account files live in the overlay (install
# layer, later changes in upper) and hide the image's own. System users and groups (id < 1000) that
# the new image has and this machine has not - by name, and with an id nobody here uses - are
# appended. Existing lines are never changed or removed; passwords are never touched (a new user
# gets the image's shadow line, which is locked in the image, or a locked one).
# Each file is rewritten as a copy + rename in the same folder (permissions kept).
ACCT_IMG=/System/Slot/System/Settings
ACCT_CUR=/System/Settings

acct_append() { # acct_append FILE LINES: append LINES (newline-terminated) to FILE atomically
   local f new
   f=$(readlink -f "$ACCT_CUR/$1")
   [ -f "$f" ] || return 1
   new="$f.gobo-update-new"
   rm -f "$new"
   cp -p "$f" "$new" || return 1
   [ -z "$(tail -c 1 "$new")" ] || echo >> "$new"
   printf '%s' "$2" >> "$new"
   sync
   mv -f "$new" "$f"
}

merge_accounts() {
   local add_g add_gs add_u add_s line name
   [ -f "$ACCT_IMG/passwd" ] && [ -f "$ACCT_IMG/group" ] || return 0
   # groups: name:x:gid:members
   add_g=$(awk -F: 'NR == FNR { if (NF == 4) { n[$1] = 1; id[$3] = 1 }; next }
      NF == 4 && $1 ~ /^[a-z_][a-z0-9_-]*$/ && $3 ~ /^[0-9]+$/ && $3 < 1000 && !($1 in n) {
         if ($3 in id) { print "SKIP " $1 > "/dev/stderr"; next }
         print; id[$3] = 1 }' "$ACCT_CUR/group" "$ACCT_IMG/group" 2>> "$LOG")
   # users: name:x:uid:gid:gecos:home:shell
   add_u=$(awk -F: 'NR == FNR { if (NF == 7) { n[$1] = 1; id[$3] = 1 }; next }
      NF == 7 && $1 ~ /^[a-z_][a-z0-9_-]*$/ && $3 ~ /^[0-9]+$/ && $3 < 1000 && !($1 in n) {
         if ($3 in id) { print "SKIP " $1 > "/dev/stderr"; next }
         print; id[$3] = 1 }' "$ACCT_CUR/passwd" "$ACCT_IMG/passwd" 2>> "$LOG")
   [ -n "$add_g$add_u" ] || return 0
   add_gs=""; add_s=""
   while IFS=: read -r name _
   do
      [ -n "$name" ] || continue
      if [ -f "$ACCT_CUR/gshadow" ] && ! grep -q "^$name:" "$ACCT_CUR/gshadow"
      then
         line=$(grep -m 1 "^$name:" "$ACCT_IMG/gshadow" 2>/dev/null || true)
         add_gs+="${line:-$name:!::}"$'\n'
      fi
      log "accounts: adding system group $name from the new system"
   done <<< "$add_g"
   while IFS=: read -r name _
   do
      [ -n "$name" ] || continue
      if ! grep -q "^$name:" "$ACCT_CUR/shadow"
      then
         line=$(grep -m 1 "^$name:" "$ACCT_IMG/shadow" 2>/dev/null || true)
         add_s+="${line:-$name:!:$(( $(date +%s) / 86400 ))::::::}"$'\n'
      fi
      log "accounts: adding system user $name from the new system"
   done <<< "$add_u"
   # groups first, so that new users' groups exist; shadow files before the visible files
   [ -n "$add_gs" ] && { acct_append gshadow "$add_gs" || log "accounts: could not update gshadow"; }
   [ -n "$add_g" ] && { acct_append group "$add_g"$'\n' || log "accounts: could not update group"; }
   [ -n "$add_s" ] && { acct_append shadow "$add_s" || log "accounts: could not update shadow"; }
   [ -n "$add_u" ] && { acct_append passwd "$add_u"$'\n' || log "accounts: could not update passwd"; }
   return 0
}

# 0.9.1: home folders are private (mode 700: only their owner gets in). New ones are made so by
# AddUser; folders of people made before are closed once (the folder itself, never what is in it).
# A marker on the data partition keeps later versions from closing a folder its owner opened again.
private_homes() {
   local h u
   [ -e "$STATE/homes-private-0.9.1" ] && return 0
   for h in /Users/*/
   do
      h=${h%/}; u=${h##*/}
      [ -d "$h" ] && [ ! -L "$h" ] || continue
      id -u "$u" > /dev/null 2>&1 || continue
      [ "$(stat -c %U "$h")" = "$u" ] || continue
      if [ "$(stat -c %a "$h")" != 700 ]
      then chmod 700 "$h" && log "accounts: home folder $h made private (700)"
      fi
   done
   : > "$STATE/homes-private-0.9.1"
}

# 0.9.1: SSH logins only for members of the group "remote" (it comes with the new image's system
# groups). Once, when it is still empty: every administrator (group sys) may connect, as before.
fill_remote_group() {
   local m u
   [ -e "$STATE/remote-group-filled" ] && return 0
   grep -q '^remote:' /System/Settings/group || return 0
   if [ -z "$(awk -F: '$1 == "remote" { print $4 }' /System/Settings/group)" ]
   then
      for m in $(awk -F: '$1 == "sys" { gsub(",", " ", $4); print $4 }' /System/Settings/group)
      do
         [[ "$m" =~ ^[a-z_][a-z0-9_-]{0,30}$ ]] || continue
         u=$(id -u "$m" 2>/dev/null) || continue
         [ "$u" -ge 1000 ] && [ "$u" -lt 60000 ] || continue
         gpasswd -a "$m" remote > /dev/null 2>&1 && log "accounts: $m may log in over SSH (group remote)"
      done
   fi
   : > "$STATE/remote-group-filled"
}

first_boot() {
   local version h u
   version=$(head -n 1 "$OVERLAY/first-boot-pending" | tr -dc '0-9A-Za-z.-')
   log "first start of version $version"
   merge_accounts || log "accounts: merge failed"
   private_homes || log "accounts: could not make the home folders private"
   fill_remote_group || log "accounts: could not fill the group remote"
   regenerate_caches || true
   # New state folders of the new version (the data partition's copy hides the slot's).
   for d in /System/Slot/Data/Variable/*
   do
      case "${d##*/}" in run|tmp|log|cache|'*') continue ;; esac
      cp -an "$d" /Data/Variable/ 2>/dev/null || true
   done
   # The look lives in the home folders: refresh it (apply.sh keeps the user's own settings).
   if [ -f "$APPLY_LOOK" ]
   then
      for h in /Users/*/
      do
         h=${h%/}; u=${h##*/}
         id -u "$u" > /dev/null 2>&1 || continue
         [ "$(stat -c %U "$h")" = "$u" ] || continue
         if [ "$u" = root ]
         then sh "$APPLY_LOOK" "$h" >> "$LOG" 2>&1 || log "apply.sh failed for $h"
         else su -s /bin/sh "$u" -c 'sh "$0" "$1"' "$APPLY_LOOK" "$h" >> "$LOG" 2>&1 || log "apply.sh failed for $h"
         fi
      done
   fi
   rm -f "$OVERLAY/first-boot-pending"
}

mark_good() {
   local def try left rb vfail
   mount_boot
   def=$(env_get slot); [ "$def" = b ] || def=a
   try=$(env_get try_slot); left=$(env_get tries_left); rb=$(env_get rollback_from)
   echo "$CUR_VERSION" > "$STATE/slot-$CUR"
   if [ "$rb" = a ] || [ "$rb" = b ]
   then
      # GRUB used up the tries of a new slot and came back here.
      vfail=$(cat "$STATE/slot-$rb" 2>/dev/null || true)
      notice rolled-back "failed_slot=$rb" "failed_version=${vfail:-?}" "running_version=$CUR_VERSION"
      env_write unset rollback_from
      log "rollback: slot $rb (${vfail:-?}) did not start, running $CUR ($CUR_VERSION)"
   fi
   if [ "$try" = "$CUR" ]
   then
      env_write set "slot=$CUR" -- unset try_slot tries_left
      notice updated "running_version=$CUR_VERSION" "previous_version=$(cat "$STATE/slot-$def" 2>/dev/null || true)"
      log "slot $CUR ($CUR_VERSION) started fine: it is the default now"
   elif { [ "$try" = a ] || [ "$try" = b ]; } && { [ -z "$left" ] || [ "$left" = 0 ]; }
   then
      # The new slot's last try ended here (GRUB fell back, e.g. its kernel did not load).
      vfail=$(cat "$STATE/slot-$try" 2>/dev/null || true)
      env_write unset try_slot tries_left
      notice rolled-back "failed_slot=$try" "failed_version=${vfail:-?}" "running_version=$CUR_VERSION"
      log "rollback: slot $try (${vfail:-?}) did not start, running $CUR ($CUR_VERSION)"
   fi
}

# 0.8.1: password hashes readable by root and group shadow only (stock 017.01: mode 644, every
# user could read them). Every start, idempotent: also fixes installs made before 0.8.1 (the
# account files live in the overlay, an update does not replace them). PAM's checks for normal
# users go through the setuid unix_chkpwd, so login, lock screen, sudo and su keep working.
secure_accounts() {
   local f
   for f in /System/Settings/shadow /System/Settings/gshadow
   do
      f=$(readlink -f "$f"); [ -f "$f" ] || continue
      if getent group shadow > /dev/null && [ "$(stat -c %G "$f")" != shadow ]
      then chgrp shadow "$f" || log "accounts: could not set the group of $f"
      fi
      if [ "$(stat -c %a "$f")" != 640 ]
      then chmod 640 "$f" && log "accounts: $f set to mode 640"
      fi
   done
}

# 0.10: a power cut while the desktop ran leaves the X server's lock files in /tmp, which is kept
# across restarts (/Data/Variable/tmp); X then refuses to start ("Server is already active for
# display 0") and the login screen never comes. At boot no X server runs yet, so they are stale.
clear_x_locks() {
   local f
   pidof Xorg X > /dev/null 2>&1 && return 0
   for f in /tmp/.X[0-9]-lock /tmp/.X[0-9][0-9]-lock
   do
      if [ -f "$f" ] || [ -L "$f" ]; then rm -f "$f" && log "removed the stale X lock $f"; fi
   done
   # the socket folder only when it is root's own real folder (not a link someone put there)
   if [ -d /tmp/.X11-unix ] && [ ! -L /tmp/.X11-unix ] && [ "$(stat -c %u /tmp/.X11-unix)" = 0 ]
   then
      for f in /tmp/.X11-unix/X[0-9] /tmp/.X11-unix/X[0-9][0-9]
      do
         if [ -S "$f" ] || [ -L "$f" ] || [ -f "$f" ]; then rm -f "$f" && log "removed the stale X socket $f"; fi
      done
   fi
   return 0
}

cmd_boot_task() {
   [ "$(cmdline_arg root)" = gobo ] || return 0
   need_root
   clear_x_locks || true
   load_layout
   mkdir -p "$STATE"; chmod 755 "$STATE"
   secure_accounts || true
   if [ "$MODE" = safe ]
   then log "started without the system changes: no first-start work, version not marked"; return 0
   fi
   [ -f "$OVERLAY/first-boot-pending" ] && first_boot
   mark_good
}

### Main #######################################################################

[ $# -gt 0 ] || { usage; exit 1; }
args=()
for a in "$@"
do
   case "$a" in
      -y|--yes) ASSUME_YES=1 ;;
      *) args+=("$a") ;;
   esac
done
set -- "${args[@]}"
case "${1:-}" in
   -h|--help) usage ;;
   --status) cmd_status ;;
   --rollback) cmd_rollback ;;
   --reset-system-changes) cmd_reset ;;
   --boot-task) cmd_boot_task ;;
   -*) usage >&2; die "unknown option $1" ;;
   *) [ $# -eq 1 ] || die "give one update file"; cmd_update "$1" ;;
esac
