#!/bin/bash
# gobo-make-system — build the pristine GoboRefined system tree (what a system slot holds).
#
#   gobo-make-system [--log FILE] SOURCE TARGET
#
# SOURCE is the live image (gobolinux-live.squashfs) or an unpacked copy of it (a directory);
# TARGET is an empty directory, normally a freshly formatted slot partition.
#
# Used by gobo-install (slot A at install time) and by spin/build-iso.sh (the .update file),
# so both are made the same way from the same image: upstream ProfileInstall runs inside the
# image itself (overlay with a throw-away layer in memory), then the spin's generic settings
# are applied. Nothing machine-specific is written here: gobo-install puts that into the
# install layer of the overlay (see dracut/90goboab/goboab-root.sh).
set -euo pipefail

LOG=/dev/null
EXCLUDE_PROGRAMS="LiveCD"

die() { echo "gobo-make-system: $*" >&2; exit 1; }

while [ $# -gt 0 ]
do
   case "$1" in
      --log) LOG="$2"; shift ;;
      -h|--help) sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
      -*) die "unknown option $1" ;;
      *) break ;;
   esac
   shift
done
[ $# -eq 2 ] || die "usage: gobo-make-system [--log FILE] SOURCE TARGET"
SRC="$1"
TGT="$(readlink -f "$2")"

[ "$(id -u)" = 0 ] || die "must be run as root"
[ -e "$SRC" ] || die "no such image: $SRC"
[ -d "$TGT" ] || die "target $TGT is not a directory"
[ "$TGT" != / ] || die "refusing / as target"
if [ -n "$(ls -A "$TGT" | grep -v -x lost+found || true)" ]
then die "target $TGT is not empty"
fi

work=$(mktemp -d /tmp/gobo-make-system.XXXXXX)
mounts=()
domount() { # domount MOUNTPOINT mount-args...
   local mp="$1"; shift
   mount "$@" "$mp" || die "mount $* $mp failed"
   mounts+=("$mp")
}
cleanup() {
   local i
   set +e
   for (( i=${#mounts[@]}-1; i>=0; i-- ))
   do umount -R "${mounts[i]}" 2>/dev/null || umount -lR "${mounts[i]}" 2>/dev/null
   done
   rmdir "$work/lower" "$work/root" "$work/rw" 2>/dev/null
   rmdir "$work" 2>/dev/null
}
trap cleanup EXIT

mkdir -p "$work/lower" "$work/rw" "$work/root"
if [ -f "$SRC" ]
then
   domount "$work/lower" -t squashfs -o ro,loop "$SRC"
   lower="$work/lower"
else
   lower="$(readlink -f "$SRC")"
fi
[ -d "$lower/Programs/Installer" ] || die "$SRC does not look like a GoboLinux live image"
domount "$work/rw" -t tmpfs -o mode=0755,size=2g gobo-make-system
mkdir -p "$work/rw/upper" "$work/rw/work"
domount "$work/root" -t overlay -o "lowerdir=$lower,upperdir=$work/rw/upper,workdir=$work/rw/work" gobo-make-system
R="$work/root"
mkdir -p "$R/Mount/GoboLinux"
domount "$R/Mount/GoboLinux" --bind "$TGT"
for pair in Status:/proc Objects:/sys Devices:/dev
do
   domount "$R/System/Kernel/${pair%%:*}" --rbind "${pair#*:}"
   mount --make-rslave "$R/System/Kernel/${pair%%:*}"
done

ls "$R/Programs" | grep -v -x -F -f <(tr ' ' '\n' <<< "$EXCLUDE_PROGRAMS") > "$R/gobo-make-system.profile"
total=$(wc -l < "$R/gobo-make-system.profile")
echo "+ ProfileInstall ($total programs)" >> "$LOG"
chroot "$R" ProfileInstall --super-user root /gobo-make-system.profile /Mount/GoboLinux 2>&1 | tee -a "$LOG" |
   awk -v total="$total" '
      /Installing program:/ { n++; printf "\r    %d/%d %-30s", n, total, $NF; fflush() }
      END { print "" }'
[ -d "$TGT/Programs/Scripts" ] && [ -d "$TGT/System/Index/bin" ] || die "the system copy did not complete"

# The image's own tree is done; leave the build environment before touching the copy.
cleanup
set -e
mounts=()
trap - EXIT
T="$TGT"
tmounts=()
tcleanup() {
   local i
   for (( i=${#tmounts[@]}-1; i>=0; i-- ))
   do umount -R "${tmounts[i]}" 2>/dev/null || umount -lR "${tmounts[i]}" 2>/dev/null || true
   done
}
trap tcleanup EXIT
for pair in Status:/proc Objects:/sys Devices:/dev
do
   mount --rbind "${pair#*:}" "$T/System/Kernel/${pair%%:*}"
   mount --make-rslave "$T/System/Kernel/${pair%%:*}"
   tmounts+=("$T/System/Kernel/${pair%%:*}")
done

### Generic settings of the spin (the same on every computer) ###############################

# ProfileInstall copies the live /media link and then runs "ln -s Mount/Media media" again,
# which lands inside it as a dangling /Mount/Media/Media. USB drives are mounted there.
[ -L "$T/Mount/Media/Media" ] && rm -f "$T/Mount/Media/Media"
chmod 700 "$T/Users/root"          # ProfileInstall leaves it at 600
rm -f "$T/System/Settings/mtab"
ln -s /proc/mounts "$T/System/Settings/mtab"

# Boot scripts: English UTF-8 locale, inittab link, wired network, the A/B boot task.
printf 'export LANG=en_US.UTF-8\nexport LC_ALL=en_US.UTF-8\n' \
   > "$T/Programs/BootScripts/Current/Resources/Environment"
chroot "$T" SymlinkProgram BootScripts >> "$LOG" 2>&1
ln -sfn /Programs/BootScripts/Settings/inittab "$T/System/Settings/inittab"
bootup="$T/Programs/BootScripts/Settings/BootScripts/BootUp"
# 0.9.1: kernel hardening settings and the firewall, before any network comes up
grep -q 'gobo-firewall boot' "$bootup" || cat >> "$bootup" <<'BOOTUP'

# Added by GoboRefined (0.9.1): kernel settings that make attacks harder (one file), and the
# firewall (nothing comes in unless it answers this computer; Settings > Network > Firewall).
Exec "Applying the kernel security settings..." sysctl -q -p /Programs/GoboSpin/Current/share/gobo-security/sysctl.conf
Exec "Starting the firewall..."                 /System/Index/bin/gobo-firewall boot
BOOTUP
grep -q 'gobo-update --boot-task' "$bootup" || cat >> "$bootup" <<'BOOTUP'

# Added by GoboRefined: get an address on the wired interface (in the background, so a
# missing cable does not delay the boot).
Exec "Starting wired network..."               dhcpcd -b -q -h "$HostName" eth0

# Added by GoboRefined (0.8, A/B system): first start of a new system version (caches, look),
# and mark this system slot as good now that the boot has come this far (see gobo-update).
Exec "Checking the system version..."          /System/Index/bin/gobo-update --boot-task
BOOTUP
grep -q 'gobo-settings-helper boot-ssh' "$bootup" || cat >> "$bootup" <<'BOOTUP'

# Added by GoboRefined (0.8.2): remote access (SSH server), only if it was switched on in
# Settings > Remote access (flag on the data partition; off by default).
Exec "Starting remote access (if switched on)..." /System/Index/bin/gobo-settings-helper boot-ssh
BOOTUP
grep -q 'gobo-settings-helper boot-bluetooth' "$bootup" || cat >> "$bootup" <<'BOOTUP'

# Added by GoboRefined (0.8.2): Bluetooth stays off after the start if it was switched off for
# good in Settings > Bluetooth (the stock "Bluetooth Start" above always powers it on).
Exec "Applying the Bluetooth setting..." /System/Index/bin/gobo-settings-helper boot-bluetooth
BOOTUP
grep -q 'gobo-settings-helper boot-devices' "$bootup" || cat >> "$bootup" <<'BOOTUP'

# Added by GoboRefined (0.9.2): a little after the start, note what the kernel said about
# missing firmware and drivers that did not start (for Settings > Device Manager).
Exec "Noting driver messages..." /System/Index/bin/gobo-settings-helper boot-devices
BOOTUP
grep -q 'gobo-settings-helper boot-apps' "$bootup" || cat >> "$bootup" <<'BOOTUP'

# Added by GoboRefined (0.9.4): MIME for programs installed through Settings > Apps
# (mimeinfo.cache + system defaults); drop apps.list rows whose programs are gone.
Exec "Refreshing Apps file types..." /System/Index/bin/gobo-settings-helper boot-apps
BOOTUP
grep -q 'gobo-settings-helper boot-disks' "$bootup" || cat >> "$bootup" <<'BOOTUP'

# Added by GoboRefined (0.10.2): the other disks of this computer (Windows, another Linux) in
# /Mount/Disks, each open only for the accounts allowed in Settings > Accounts > Disks; NTFS
# read-write, read-only if Windows did not shut down fully. Nobody stays in the group "disk".
Exec "Opening the other disks..." /System/Index/bin/gobo-settings-helper boot-disks
BOOTUP
# 0.8.4: the computer's Bluetooth name is its host name (main.conf, written before bluetoothd starts)
if ! grep -q 'gobo-settings-helper boot-bluetooth-name' "$bootup"
then
   sed -i 's|^\(Exec "Starting Bluetooth daemon\.\.\."\)|Exec "Setting the Bluetooth name..."           /System/Index/bin/gobo-settings-helper boot-bluetooth-name\n\1|' "$bootup"
   grep -q 'gobo-settings-helper boot-bluetooth-name' "$bootup" || die "could not add the Bluetooth name step to BootUp"
fi
# 0.10.3: /etc/machine-id (the same ID as D-Bus's, written into the install layer) before the
# message bus starts
if ! grep -q 'gobo-settings-helper boot-machine-id' "$bootup"
then
   sed -i 's|^\(Exec "Starting message bus\.\.\."\)|Exec "Checking the machine ID..."             /System/Index/bin/gobo-settings-helper boot-machine-id\n\1|' "$bootup"
   grep -q 'gobo-settings-helper boot-machine-id' "$bootup" || die "could not add the machine ID step to BootUp"
fi
printf 'nameserver 208.67.222.222\nnameserver 208.67.220.220\n' > "$T/System/Settings/resolv.conf"
cp "$T/System/Settings/resolv.conf" "$T/System/Settings/resolv.conf.tail"

# The desktop's power menu runs these through sudo; group "sys" (may use sudo at all) may
# run them without a password. 0.9.1: exactly the two commands the power menu uses (before:
# shutdown/reboot/poweroff/halt with any arguments).
sudoers="$T/Programs/Sudo/Settings/sudoers"
if [ -f "$sudoers" ] && ! grep -q 'NOPASSWD: /System/Index/bin/shutdown' "$sudoers"
then
   echo '%sys ALL=(root) NOPASSWD: /System/Index/bin/shutdown -r now, /System/Index/bin/shutdown -h now' >> "$sudoers"
fi
# 0.9.1: sudo starts commands with a clean environment and a fixed PATH (stock 017.01: the caller's
# whole environment, "!env_reset"); administrators may still keep theirs with "sudo -E" (setenv);
# a password is remembered for 5 minutes.
if [ -f "$sudoers" ] && grep -q '^Defaults[[:space:]]*!env_reset' "$sudoers"
then
   sed -i 's|^Defaults[[:space:]]*!env_reset.*$|# GoboRefined 0.9.1 (stock: "Defaults !env_reset, setenv"):\nDefaults env_reset\nDefaults secure_path="/System/Index/bin:/System/Index/sbin"\nDefaults timestamp_timeout=5\nDefaults:%sys setenv|' "$sudoers"
   grep -q '^Defaults env_reset$' "$sudoers" || die "could not change the sudo defaults"
fi
# 0.8.2: Settings app. Administrators (group sys) may run everything through sudo anyway;
# standard users may change their own password and read the root part of the system report
# through the Settings helper (WITH their password), and restart/shut down from the power
# menu without one, like administrators.
if [ -f "$sudoers" ] && ! grep -q 'gobo-settings-helper own-password' "$sudoers"
then
   cat >> "$sudoers" <<'SUDOERS'
%users ALL=(root) /System/Index/bin/gobo-settings-helper own-password, /System/Index/bin/gobo-settings-helper report
%users ALL=(root) NOPASSWD: /System/Index/bin/shutdown -r now, /System/Index/bin/shutdown -h now
SUDOERS
fi
chroot "$T" visudo -c > /dev/null || die "the sudo configuration is not valid"

# 0.9.1: the spin's account groups, with fixed ids below 1000 (gobo-update's first start adds
# system groups of a new image to existing installs): "simple" = Simple accounts, "remote" = who
# may log in over SSH (Settings > Remote access).
for g in simple:970 remote:971 gobo-usb:969
do
   if ! grep -q "^${g%%:*}:" "$T/System/Settings/group"
   then chroot "$T" groupadd -g "${g#*:}" "${g%%:*}" >> "$LOG" 2>&1 || die "could not create the group ${g%%:*}"
   fi
done

# 0.10.2: disks per account (gobo-settings-helper: boot-disks, disk-access). 017.01's AddUser
# put every new account into "disk" (raw read access to every disk, past all file permissions):
# not any more. USB drives through udevil only for the group gobo-usb (administrators and
# standard accounts always; Simple accounts by their switch in Settings > Accounts > Disks).
adduser=$(readlink -f "$T/System/Index/bin/AddUser" 2>/dev/null || true)
case "$adduser" in "$T"/Programs/Scripts/*) ;; *) adduser=$(ls "$T"/Programs/Scripts/*/bin/AddUser 2>/dev/null | head -n 1) ;; esac
[ -f "$adduser" ] || die "AddUser not found"
sed -i 's/^\(usermod -g users -G tty,tape,floppy,\)disk,\(lp,\)/\1\2/' "$adduser"
grep -q '^usermod -g users -G .*disk' "$adduser" && die "could not take the group disk out of AddUser"
udevil_conf=$T/Programs/Udevil/Settings/udevil/udevil.conf
[ -f "$udevil_conf" ] || die "udevil.conf not found"
sed -i 's/^allowed_groups = .*/allowed_groups = gobo-usb/' "$udevil_conf"
grep -qx 'allowed_groups = gobo-usb' "$udevil_conf" || die "could not limit udevil to the group gobo-usb"

# 0.9.1: setuid audit (docs/security.md). The 1980s remote shell clients need no root rights on a
# desktop (nothing here runs rshd/rlogind; ssh replaced them): the bit is taken away.
for f in rsh rlogin rcp
do
   for p in "$T"/Programs/InetUtils/*/bin/$f
   do
      if [ -f "$p" ] && [ ! -L "$p" ]; then chmod u-s,g-s "$p"; fi
   done
done
# The same for lsof (as root it showed every user the open files of all others; without the bit it
# lists the caller's own programs) and ksu (Kerberos "su": no Kerberos is set up here).
for p in "$T"/Programs/Lsof/*/bin/lsof "$T"/Programs/Kerberos/*/bin/ksu
do
   if [ -f "$p" ] && [ ! -L "$p" ]; then chmod u-s,g-s "$p"; fi
done

# 0.8.1: password hashes for root and group shadow only (stock: 644). gobo-update's boot task
# does the same on every start for systems installed earlier.
for f in shadow gshadow
do
   if [ -f "$T/System/Settings/$f" ]
   then
      chroot "$T" chgrp shadow "/System/Settings/$f" 2>> "$LOG" || true
      chmod 640 "$T/System/Settings/$f"
   fi
done

# 0.8.1: the X server starts through gobo-xorg (preloads gobo-udev-dev.so) so it sees input
# devices plugged in later (GoboSpin; without it a re-plugged USB mouse stayed dead).
if [ -x "$T/Programs/GoboSpin/Current/bin/gobo-xorg" ] && [ -e "$T/Programs/GoboSpin/Current/lib/gobo-udev-dev.so" ]
then
   ln -sfn /Programs/GoboSpin/Current/bin/gobo-xorg "$T/System/Index/bin/X"
   [ -e "$T/System/Index/lib/gobo-udev-dev.so" ] ||
      ln -sfn /Programs/GoboSpin/Current/lib/gobo-udev-dev.so "$T/System/Index/lib/gobo-udev-dev.so"
fi

# 0.8.3: Intel graphics use the kernel modesetting driver (Xorg picked the old "intel" DDX on a
# Tiger Lake laptop: only a thin strip of the desktop showed). 0.8.4: i915, xe, amdgpu, radeon (not nouveau).
# 0.8.4: + touchpad tap to click (30-gobo-touchpad.conf). Every snippet in share/gobo-xorg is copied.
for xorg_snippet in "$T"/Programs/GoboSpin/Current/share/gobo-xorg/*.conf
do
   [ -f "$xorg_snippet" ] || continue
   mkdir -p "$T/System/Settings/X11/xorg.conf.d"
   install -m 644 "$xorg_snippet" "$T/System/Settings/X11/xorg.conf.d/$(basename "$xorg_snippet")"
done

# 0.8.1: short press of the power button (acpid had no rule at all): power menu on the
# desktop, clean shutdown at the login screen or a text console (GoboSpin's gobo-power-button).
acpi_events="$T/Programs/Acpid/Settings/acpi/events"
if [ -d "$T/Programs/Acpid/Settings/acpi" ]
then
   mkdir -p "$acpi_events"
   printf '# GoboRefined 0.8.1: power button\nevent=button[ /]power\naction=/System/Index/bin/gobo-power-button\n' \
      > "$acpi_events/gobo-power-button"
fi

# 0.9.4: the file manager's "Open with" list needs mimeinfo.cache (the image has no
# update-desktop-database): "gobo-settings-helper boot-apps" (BootUp line above) writes it at
# every start, from all menu entries in /System/Index/share/applications.

# A/B layout: mount points used by the initramfs, a fixed name for GRUB to load.
mkdir -p "$T/System/Slot" "$T/System/Data" "$T/System/Kernel/ESP"
kernel_file=$(readlink "$T/System/Kernel/Boot/kernel")        # kernel-6.12.16-Gobo
initramfs="initramfs-${kernel_file#kernel-}.img"
[ -e "$T/System/Kernel/Boot/$initramfs" ] || die "no $initramfs in the image"
ln -sfn "$initramfs" "$T/System/Kernel/Boot/initramfs"
initramfs_list=$(lsinitrd "$T/System/Kernel/Boot/$initramfs" 2>/dev/null || true)
grep -q 'bin/goboab-root' <<< "$initramfs_list" ||
   die "the image's initramfs has no GoboRefined A/B support (goboab)"
[ -x "$T/Programs/GoboSpin/Current/bin/gobo-update" ] && [ -L "$T/System/Index/bin/gobo-update" ] ||
   die "gobo-update is missing in the image"   # (links are absolute: check the program and the link)

tcleanup
trap - EXIT
sync
echo "System tree ready in $T ($(du -sh "$T" 2>/dev/null | cut -f1))"
