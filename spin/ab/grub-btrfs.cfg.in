# gobo-grub-template 2
# GoboRefined boot menu for the btrfs layout (0.10, PROTOTYPE: docs/ab-btrfs-plan.md). grub.cfg on GOBO_BOOT.
# Placeholders (names between at-signs): UUID_BOOT UUID_POOL PARTUUID_POOL VIDEO.
# GRUB reads only GOBO_BOOT (FAT): each version's kernel, initramfs and gobo-slot.env are in
# /gobo/a and /gobo/b there; the system itself is subvolume @system-a or @system-b of GOBO_POOL
# (btrfs), which only the kernel reads. gobo-slot.env in /gobo/<x> is written last when a version
# is complete; a version without it is not offered.
# grubenv as in the 0.8 layout: slot, try_slot, tries_left, rollback_from.
# The gobo_uuid_a/b/data and gobo_partuuid_a/b lines exist only so that the boot task of a 0.9.x
# system (gobo-update --boot-task: reads them, then only changes grubenv) works in the prototype;
# they all name the pool.
set gobo_layout=btrfs
set gobo_uuid_boot=@UUID_BOOT@
set gobo_uuid_pool=@UUID_POOL@
set gobo_uuid_a=@UUID_POOL@
set gobo_uuid_b=@UUID_POOL@
set gobo_uuid_data=@UUID_POOL@
set gobo_partuuid_a=@PARTUUID_POOL@
set gobo_partuuid_b=@PARTUUID_POOL@
set gobo_args="vt.default_utf8=1 rootwait net.ifnames=0"

set timeout=5
insmod part_gpt
insmod fat
insmod loadenv
insmod test
@VIDEO@

load_env -f $prefix/grubenv
search --no-floppy --fs-uuid --set=gobo_bootdev $gobo_uuid_boot

# What each version holds (gobo/<x>/gobo-slot.env on GOBO_BOOT is written last).
set ver_a=""
set ver_b=""
if [ -f ($gobo_bootdev)/gobo/a/gobo-slot.env ]; then
   set slot_version="?"
   load_env -f ($gobo_bootdev)/gobo/a/gobo-slot.env slot_version
   set ver_a="$slot_version"
fi
if [ -f ($gobo_bootdev)/gobo/b/gobo-slot.env ]; then
   set slot_version="?"
   load_env -f ($gobo_bootdev)/gobo/b/gobo-slot.env slot_version
   set ver_b="$slot_version"
fi

# Which version starts: the default, or a new one for at most two tries (as in template 1).
if [ "$slot" != b ]; then set slot=a; fi
set boot_slot=$slot
set try_args=""
if [ "$try_slot" = a -o "$try_slot" = b ]; then
   if [ "$tries_left" = 2 ]; then
      set tries_left=1
      save_env -f $prefix/grubenv tries_left
      set boot_slot=$try_slot
   elif [ "$tries_left" = 1 ]; then
      set tries_left=0
      save_env -f $prefix/grubenv tries_left
      set boot_slot=$try_slot
   else
      set rollback_from=$try_slot
      set try_slot=""
      set tries_left=""
      save_env -f $prefix/grubenv rollback_from try_slot tries_left
   fi
fi
if [ "$boot_slot" = a -a -z "$ver_a" ]; then set boot_slot=b; fi
if [ "$boot_slot" = b -a -z "$ver_b" ]; then set boot_slot=a; fi
if [ -n "$try_slot" -a "$boot_slot" = "$try_slot" ]; then
   set try_args="rd.shell=0 rd.emergency=reboot panic=10"
   set fallback="slot-$slot"
fi
set default="slot-$boot_slot"
export gobo_bootdev gobo_uuid_pool gobo_uuid_boot gobo_args try_slot try_args

function gobo_boot {
   set x=""
   if [ "$1" = "$try_slot" ]; then set x="$try_args"; fi
   echo "Starting GoboRefined (version $1, btrfs) ..."
   linux ($gobo_bootdev)/gobo/$1/kernel root=gobo gobo.layout=btrfs gobo.slot=$1 gobo.root=UUID=$gobo_uuid_pool gobo.data=UUID=$gobo_uuid_pool gobo.boot=UUID=$gobo_uuid_boot $gobo_args $x $2 $3
   initrd ($gobo_bootdev)/gobo/$1/initramfs
}

if [ -n "$ver_a" ]; then
   menuentry "GoboRefined $ver_a (A)" --id slot-a { gobo_boot a }
   menuentry "GoboRefined $ver_a (A) - without my system changes" --id slot-a-pristine { gobo_boot a gobo.system-changes=off }
   menuentry "GoboRefined $ver_a (A) - safe graphics" --id slot-a-safe { gobo_boot a nomodeset }
else
   menuentry "A: empty" --id empty-a { echo "Version A is empty or incomplete. A system update fills it."; sleep 5 }
fi
if [ -n "$ver_b" ]; then
   menuentry "GoboRefined $ver_b (B)" --id slot-b { gobo_boot b }
   menuentry "GoboRefined $ver_b (B) - without my system changes" --id slot-b-pristine { gobo_boot b gobo.system-changes=off }
   menuentry "GoboRefined $ver_b (B) - safe graphics" --id slot-b-safe { gobo_boot b nomodeset }
else
   menuentry "B: empty" --id empty-b { echo "Version B is empty. The first system update fills it."; sleep 5 }
fi
