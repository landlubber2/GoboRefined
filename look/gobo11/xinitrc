setxkbmap -model pc104 -layout us
numlockx &
xsetroot -solid '#0b1630' -cursor_name left_ptr

# Load user preferences
[ -e ~/.Xresources ] && xrdb -merge ~/.Xresources

# Update the MIME database
[ -e /bin/update-mime-database ] && \
    update-mime-database /Data/Variable/xdg/mime > /dev/null 2>&1 &

# Launch PulseAudio daemon
[ -e /bin/pulseaudio ] && /bin/pulseaudio --start

# Extend the desktop across every connected display
sh ~/.config/awesome/displays.sh

# Lock the screen after 10 minutes without input, and before sleep
xset s 600 5
[ -x /bin/xss-lock ] && xss-lock -l -- sh ~/.config/awesome/lock.sh &

# USB sticks: devmon (udevil) mounts them under /Mount/Media/<label>; the taskbar
# shows a notification and a drive icon (open / safely remove). Awesome stops it at log out.
# The system's own partitions (A/B layout, 0.8) are never mounted as drives.
[ -x /bin/devmon ] && devmon --ignore-label GOBO_BOOT --ignore-label GOBO_A --ignore-label GOBO_B \
   --ignore-label GOBO_DATA > /dev/null 2>&1 &

# Clipboard history: CopyQ keeps the last 20 copies, also after their program has closed
# (no tray icon; Win+Shift+V lists them). Settings in ~/.config/copyq/.
[ -x /bin/copyq ] && copyq > /dev/null 2>&1 &

# Shadows and fades
[ -x /bin/picom ] && picom -b --config ~/.config/picom.conf

[ -x /bin/awesome ] && exec awesome
[ -x /bin/twm ] && exec twm
