[Desktop Entry]
Type=Action
Name=Install
Tooltip=Move this AppImage to its own folder in ~/Applications and add it to the start menu
Icon=system-software-install
TryExec=gobo-appimage-install
Profiles=install;

[X-Action-Profile install]
Name=Install
Exec=gobo-appimage-install %f
MimeTypes=all/allfiles;
Basenames=*.AppImage;*.appimage;
Matchcase=false
SelectionCount=1
ShowIfTrue=gobo-appimage-install --offer %f
