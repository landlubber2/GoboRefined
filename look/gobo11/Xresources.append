
! ---- gobo11 look (appended by apply.sh; later lines override earlier ones) ----
Xcursor.theme: Adwaita
Xcursor.size: 24
Xft.antialias: 1
Xft.hinting: 1
Xft.hintstyle: hintslight
Xft.rgba: rgb
URxvt.font: xft:JetBrains Mono:size=11
URxvt.boldFont: xft:JetBrains Mono:bold:size=11
URxvt.italicFont: xft:JetBrains Mono:italic:size=11
URxvt.boldItalicFont: xft:JetBrains Mono:bold:italic:size=11
URxvt.letterSpace: 0
! Ctrl+Alt+1..9: bigger terminal text, Ctrl+Alt+0: back to normal (same font)
URxvt.keysym.M-C-1: command:\033]710;xft:JetBrains Mono:pixelsize=12\007\033]711;xft:JetBrains Mono:bold:pixelsize=12\007
URxvt.keysym.M-C-2: command:\033]710;xft:JetBrains Mono:pixelsize=14\007\033]711;xft:JetBrains Mono:bold:pixelsize=14\007
URxvt.keysym.M-C-3: command:\033]710;xft:JetBrains Mono:pixelsize=16\007\033]711;xft:JetBrains Mono:bold:pixelsize=16\007
URxvt.keysym.M-C-4: command:\033]710;xft:JetBrains Mono:pixelsize=18\007\033]711;xft:JetBrains Mono:bold:pixelsize=18\007
URxvt.keysym.M-C-5: command:\033]710;xft:JetBrains Mono:pixelsize=20\007\033]711;xft:JetBrains Mono:bold:pixelsize=20\007
URxvt.keysym.M-C-6: command:\033]710;xft:JetBrains Mono:pixelsize=22\007\033]711;xft:JetBrains Mono:bold:pixelsize=22\007
URxvt.keysym.M-C-7: command:\033]710;xft:JetBrains Mono:pixelsize=24\007\033]711;xft:JetBrains Mono:bold:pixelsize=24\007
URxvt.keysym.M-C-8: command:\033]710;xft:JetBrains Mono:pixelsize=26\007\033]711;xft:JetBrains Mono:bold:pixelsize=26\007
URxvt.keysym.M-C-9: command:\033]710;xft:JetBrains Mono:pixelsize=28\007\033]711;xft:JetBrains Mono:bold:pixelsize=28\007
URxvt.keysym.M-C-0: command:\033]710;xft:JetBrains Mono:size=11\007\033]711;xft:JetBrains Mono:bold:size=11\007
URxvt.depth: 32
URxvt.background: rgba:0c0c/0c0c/0c0c/f2f2
URxvt.foreground: #cccccc
URxvt.cursorColor: #ffffff
URxvt.cursorBlink: true
URxvt.internalBorder: 10
URxvt.scrollBar: false
URxvt.colorBD: #ffffff
URxvt.colorIT: #cccccc
URxvt.color0: #0c0c0c
URxvt.color1: #c50f1f
URxvt.color2: #13a10e
URxvt.color3: #c19c00
URxvt.color4: #3b78ff
URxvt.color5: #881798
URxvt.color6: #3a96dd
URxvt.color7: #cccccc
URxvt.color8: #767676
URxvt.color9: #e74856
URxvt.color10: #16c60c
URxvt.color11: #f9f1a5
URxvt.color12: #6ea8ff
URxvt.color13: #b4009e
URxvt.color14: #61d6d6
URxvt.color15: #f2f2f2
! Mouse-only copy and paste: selecting text copies it (also to the clipboard),
! right click pastes the clipboard (extension ~/.urxvt/ext/gobo-paste);
! Ctrl+Shift+C / Ctrl+Shift+V copy and paste with the keyboard.
URxvt.perl-ext-common: default,matcher,tabbedex,eval,selection-to-clipboard,gobo-paste
URxvt.iso14755: false
URxvt.iso14755_52: false
URxvt.keysym.Shift-Control-C: eval:selection_to_clipboard
URxvt.keysym.Shift-Control-V: eval:paste_clipboard
! ---- end of gobo11 look ----
