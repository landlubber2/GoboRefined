# Large or machine-specific things that do not belong in git
*.iso
/vm/GoboLinux-017.01/
/upstream/
/dist/*.tgz
/dist/*.update

# Lab-only secrets and generated files
/vm/ssh/
/vm/keys/
/vm/serve/k
/vm/serve/lab-answers.env
/vm/serve/*.tgz
# old lab packages (no longer used: build/build.sh compiles everything)
/spin/programs/

# Internal notes (local only; not published)
*.md
!/README.md
!/BUILDING.md
!/docs/third-party.md
!/docs/software-install.md
# dist/README.md is release notes for local ISO users (kept next to the files; not required on GitHub)

# Lab and build leftovers (local only)
/dist/*.build.log
/dist/*.update-signing.pub.pem
/vm/serve/*.png
/vm/serve/run-*.sh
/vm/lab-ssh-cmd.sh
/vm/scratch/
